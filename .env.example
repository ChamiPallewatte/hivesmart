# ==========================================
# HIVESMART ENVIRONMENT CONFIGURATION
# Copy this file to .env for local development
# NEVER commit .env to GitHub
# ==========================================

# Agency Domain & Canonical Base URL
PUBLIC_SITE_URL="https://hivesmart.io"

# Analytics Configuration
# Cloudflare Web Analytics Token (optional, privacy-friendly)
PUBLIC_CF_ANALYTICS_TOKEN=""

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GA4_ID=""

# Google Tag Manager Container ID (optional, e.g. GTM-XXXXXXX)
PUBLIC_GTM_ID=""

# Search Engine Site Verification
PUBLIC_GOOGLE_SITE_VERIFICATION=""
PUBLIC_BING_SITE_VERIFICATION=""

# Admin Dashboard Security
# Change this secret in production!
ADMIN_SECRET_KEY="replace_with_secure_random_string_in_production"
ADMIN_SESSION_PASSWORD="replace_with_strong_admin_password"

# Contact Numbers (WhatsApp & Voice)
# Sri Lanka WhatsApp Link format (no + sign or spaces)
PUBLIC_WA_NUMBER_LK="94778091278"
# Sri Lanka Display Voice/WhatsApp format
PUBLIC_DISPLAY_PHONE_LK="+94 77 809 1278"
PUBLIC_ADDRESS_LK="Kegalle, Sri Lanka"

# Dubai UAE WhatsApp Link format (no + sign or spaces)
PUBLIC_WA_NUMBER_UAE="971547713570"
# Dubai UAE Display Voice/WhatsApp format
PUBLIC_DISPLAY_PHONE_UAE="+971 54 771 5370"
PUBLIC_ADDRESS_UAE="Al Rigga, Deira, Dubai, UAE"

# Database Configuration (for Prisma migration / local testing)
# In Cloudflare runtime, the D1 binding 'DB' is automatically provided via platform.env.DB
DATABASE_URL="file:./prisma/dev.db"

