{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hivesmart",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hivesmart-db",
      "database_id": "hivesmart-production-db"
    }
  ],
  "observability": {
    "enabled": true
  }
}
