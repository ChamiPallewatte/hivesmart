---
import type { StaticBlogPost } from '../lib/database/initial-posts';

interface Props {
  post: StaticBlogPost;
}

const { post } = Astro.props;

const formattedDate = new Date(post.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<article class="flex flex-col bg-[#081736]/80 rounded-3xl border border-amber-500/20 shadow-xl hover:border-amber-500/60 transition-all duration-300 card-glow-hover group overflow-hidden">
  <!-- Card Visual -->
  <a href={`/blog/${post.slug}/`} class="block relative aspect-video bg-[#050e22] overflow-hidden" aria-label={`Read ${post.title}`}>
    <img
      src={post.featuredImage}
      alt={post.title}
      loading="lazy"
      decoding="async"
      width="600"
      height="350"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute top-4 left-4">
      <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-[#050e22]/90 text-amber-400 border border-amber-500/40 backdrop-blur-md">
        {post.category.name}
      </span>
    </div>
  </a>

  <!-- Content Area -->
  <div class="p-6 flex flex-col flex-1 justify-between">
    <div>
      <div class="flex items-center gap-3 text-xs text-slate-400 mb-3 font-mono">
        <span>{formattedDate}</span>
        <span>•</span>
        <span>{post.readingTime} min read</span>
      </div>

      <h3 class="text-xl font-bold text-white group-hover:text-amber-400 transition-colors line-clamp-2 mb-3 leading-snug">
        <a href={`/blog/${post.slug}/`}>
          {post.title}
        </a>
      </h3>

      <p class="text-sm text-slate-300 line-clamp-3 leading-relaxed mb-6 font-normal">
        {post.description}
      </p>
    </div>

    <div class="pt-4 border-t border-slate-800 flex items-center justify-between">
      <span class="text-xs font-semibold text-slate-400">
        By {post.author}
      </span>
      <span class="text-xs font-bold text-amber-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
        <span>Read Article</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </span>
    </div>
  </div>
</article>
