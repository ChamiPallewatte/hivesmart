---
import { SITE_CONFIG } from '../config/site';
import SearchBar from './SearchBar.astro';
import WhatsAppButton from './WhatsAppButton.astro';
---

<section class="relative overflow-hidden pt-12 pb-24 md:pt-20 md:pb-36 bg-[#050e22] text-white">
  <!-- Honeycomb Circuit Hex Background Pattern -->
  <div class="absolute inset-0 bg-honeycomb-pattern opacity-40 pointer-events-none"></div>

  <!-- Ambient Glowing Gold Light Orbs -->
  <div class="glow-orb-gold top-10 left-1/2 -translate-x-1/2 w-[700px] h-[350px] opacity-40"></div>
  <div class="glow-orb-gold -top-20 left-10 w-[400px] h-[400px] opacity-20"></div>
  <div class="glow-orb-gold top-60 right-10 w-[450px] h-[450px] opacity-25"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    
    <!-- Top Central Brand Symbol Badge -->
    <div class="flex justify-center mb-6">
      <div class="p-2.5 px-4 rounded-3xl bg-[#081736]/90 border border-amber-500/40 shadow-xl shadow-amber-950/50 inline-flex items-center gap-3 backdrop-blur-xl">
        <img
          src="/images/logo-icon.png"
          alt="HiveSmart Official Mark"
          class="w-9 h-9 md:w-10 md:h-10 object-contain drop-shadow"
          width="40"
          height="40"
          loading="eager"
        />
        <div class="text-left">
          <span class="text-sm md:text-base font-black text-white tracking-tight leading-none block">
            Hive <span class="text-amber-400">smart</span>
          </span>
          <span class="text-[9px] uppercase tracking-widest font-extrabold text-amber-400/90 mt-0.5 block">
            Premier Digital Agency
          </span>
        </div>
      </div>
    </div>

    <!-- Live Regional Strategic Hubs Pill -->
    <div class="inline-flex items-center gap-2.5 p-1.5 pr-4 rounded-full bg-[#081736]/80 border border-amber-500/30 shadow-lg mb-8 select-none backdrop-blur-md">
      <span class="flex h-2.5 w-2.5 relative ml-1.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-80"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
      </span>
      <span class="text-xs font-semibold text-slate-200">
        Active Regional Engineering Hubs: 
        <span class="text-amber-400 font-bold">🇱🇰 Sri Lanka</span> & 
        <span class="text-amber-400 font-bold">🇦🇪 Dubai (UAE)</span>
      </span>
    </div>

    <!-- Main Eye-Catching Headline -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-white leading-[1.08] mb-6">
      Building Digital Experiences <br class="hidden sm:block" />
      <span class="text-gradient-gold">That Grow Your Business.</span>
    </h1>

    <!-- Supporting Narrative -->
    <p class="max-w-3xl mx-auto text-lg sm:text-xl text-slate-300 leading-relaxed mb-10 font-normal">
      {SITE_CONFIG.subTagline} High-speed websites, ATS-friendly CV architecture, and custom mobile apps engineered for immediate customer acquisition.
    </p>

    <!-- CTAs Row -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
      <a
        href="/services/"
        class="w-full sm:w-auto px-8 py-4 rounded-2xl font-black text-base text-[#081736] bg-gradient-to-r from-amber-400 via-amber-500 to-amber-400 hover:from-amber-300 hover:to-amber-500 shadow-xl shadow-amber-500/25 hover:shadow-2xl transition-all duration-200 active:scale-95 inline-flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>Explore Our Services</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>

      <WhatsAppButton
        location="lk"
        variant="primary"
        size="lg"
        label="Chat on WhatsApp"
        placement="hero"
        class="w-full sm:w-auto"
      />
    </div>

    <!-- The Modern Spotlight Live Search Bar Component -->
    <div class="w-full pt-2 pb-4">
      <SearchBar
        large={true}
        placeholder="Search services (e.g. Website Development, WordPress, CV Design, Mobile Apps)..."
      />
    </div>

    <!-- Floating High-Impact Performance Metrics Strip -->
    <div class="mt-16 pt-10 border-t border-slate-800/80 grid grid-cols-2 md:grid-cols-4 gap-6 text-left">
      <div class="p-4 rounded-2xl bg-[#081736]/60 border border-slate-800 hover:border-amber-500/40 transition-colors">
        <div class="text-2xl sm:text-3xl font-black text-amber-400 mb-1 font-mono">0.3s</div>
        <div class="text-xs font-bold text-white uppercase tracking-wider">Sub-Second Edge Speed</div>
        <p class="text-[11px] text-slate-400 mt-0.5">Cloudflare 300+ CDN nodes</p>
      </div>

      <div class="p-4 rounded-2xl bg-[#081736]/60 border border-slate-800 hover:border-amber-500/40 transition-colors">
        <div class="text-2xl sm:text-3xl font-black text-emerald-400 mb-1 font-mono">100%</div>
        <div class="text-xs font-bold text-white uppercase tracking-wider">Core Web Vitals</div>
        <p class="text-[11px] text-slate-400 mt-0.5">Google algorithm optimized</p>
      </div>

      <div class="p-4 rounded-2xl bg-[#081736]/60 border border-slate-800 hover:border-amber-500/40 transition-colors">
        <div class="text-2xl sm:text-3xl font-black text-amber-400 mb-1 font-mono">1-Tap</div>
        <div class="text-xs font-bold text-white uppercase tracking-wider">Direct WhatsApp</div>
        <p class="text-[11px] text-slate-400 mt-0.5">Zero-friction lead conversion</p>
      </div>

      <div class="p-4 rounded-2xl bg-[#081736]/60 border border-slate-800 hover:border-amber-500/40 transition-colors">
        <div class="text-2xl sm:text-3xl font-black text-sky-400 mb-1 font-mono">2 Hubs</div>
        <div class="text-xs font-bold text-white uppercase tracking-wider">LK & UAE Offices</div>
        <p class="text-[11px] text-slate-400 mt-0.5">Local consultants & support</p>
      </div>
    </div>

  </div>
</section>
