---
import type { ServiceDefinition } from '../config/services';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  service: ServiceDefinition;
  searchKeyword?: string;
}

const { service, searchKeyword } = Astro.props;
const isPrimary = service.isPrimary;
---

<div
  class={`relative rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 group ${
    isPrimary
      ? 'bg-gradient-to-b from-amber-500/10 via-white to-white dark:from-[#0a1935] dark:via-[#081736] dark:to-[#081736] border-2 border-amber-500 shadow-2xl shadow-amber-900/10 hover:border-amber-400 lg:col-span-2'
      : 'bg-white dark:bg-[#081736] border border-amber-500/20 dark:border-amber-500/15 shadow-xl shadow-slate-900/5 hover:border-amber-500/50'
  }`}
  id={`service-${service.slug}`}
>
  <div>
    <!-- Top Meta Row -->
    <div class="flex items-center justify-between mb-6">
      <span
        class={`text-xs font-black uppercase tracking-wider px-3.5 py-1 rounded-full ${
          isPrimary
            ? 'bg-gradient-to-r from-amber-500 to-orange-500 text-slate-950 font-extrabold shadow-sm'
            : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300'
        }`}
      >
        {service.badge}
      </span>

      <!-- Service Detail Arrow Link -->
      <a
        href={`/services/${service.slug}/`}
        class="text-xs font-bold text-amber-600 dark:text-amber-400 group-hover:underline inline-flex items-center gap-1"
      >
        <span>Full Details</span>
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Title & Tagline -->
    <h3 class={`text-2xl font-black tracking-tight text-[#081736] dark:text-white mb-2 ${isPrimary ? 'sm:text-3xl' : ''}`}>
      <a href={`/services/${service.slug}/`} class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors">
        {service.title}
      </a>
    </h3>
    <p class="text-sm font-semibold text-amber-600 dark:text-amber-400 mb-4">
      {service.tagline}
    </p>

    <!-- Description -->
    <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
      {service.shortDescription}
    </p>

    <!-- Sub-services / Key Features Pill Grid -->
    <div class="space-y-2 mb-8">
      <p class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400">Key Offerings:</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        {service.subServices.slice(0, isPrimary ? 6 : 4).map((sub) => (
          <div class="flex items-start gap-2 text-xs font-medium text-slate-700 dark:text-slate-300">
            <svg class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>{sub.title}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom CTA Row -->
  <div class="pt-6 border-t border-amber-500/15 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
    <a
      href={`/services/${service.slug}/`}
      class="text-sm font-bold text-slate-700 dark:text-slate-300 hover:text-amber-600 dark:hover:text-amber-400 transition-colors"
    >
      Learn More & View Process →
    </a>

    <div class="flex items-center gap-2 w-full sm:w-auto">
      <WhatsAppButton
        location="lk"
        serviceName={service.title}
        customMessage={service.whatsappMessage}
        label={service.ctaText}
        variant={isPrimary ? 'primary' : 'outline'}
        size="md"
        searchKeyword={searchKeyword}
        placement={`service_card_${service.slug}`}
        class="w-full sm:w-auto"
      />
    </div>
  </div>
</div>
