---
import type { ServiceDefinition } from '../config/services';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  service: ServiceDefinition;
  searchKeyword?: string;
}

const { service, searchKeyword } = Astro.props;
const isPrimary = service.isPrimary;
---

<div
  class={`relative rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 card-glow-hover glass-panel-luxury ${
    isPrimary
      ? 'border-2 border-amber-500/70 shadow-2xl shadow-amber-950/50 lg:col-span-2 bg-[#081736]/90'
      : 'border border-amber-500/30 shadow-xl bg-[#081736]/75'
  }`}
  id={`service-${service.slug}`}
>
  {isPrimary && (
    <div class="absolute -top-3.5 right-8">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest bg-gradient-to-r from-amber-400 to-amber-500 text-[#081736] shadow-md">
        ⭐ High Demand Core Specialization
      </span>
    </div>
  )}

  <div>
    <!-- Top Meta Row -->
    <div class="flex items-center justify-between mb-5">
      <span
        class={`text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full ${
          isPrimary
            ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40'
            : 'bg-slate-800 text-slate-300 border border-slate-700'
        }`}
      >
        {service.badge}
      </span>

      <!-- Service Detail Arrow Link -->
      <a
        href={`/services/${service.slug}/`}
        class="text-xs font-bold text-amber-400 hover:text-amber-300 inline-flex items-center gap-1 group/link"
      >
        <span>Specifications & Pricing</span>
        <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Title & Tagline -->
    <h3 class={`text-2xl font-black tracking-tight text-white mb-2 ${isPrimary ? 'sm:text-3xl' : ''}`}>
      <a href={`/services/${service.slug}/`} class="hover:text-amber-400 transition-colors">
        {service.title}
      </a>
    </h3>
    <p class="text-sm font-semibold text-amber-400 mb-4">
      {service.tagline}
    </p>

    <!-- Description -->
    <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6 font-normal">
      {service.shortDescription}
    </p>

    <!-- Sub-services / Key Features Pill Grid -->
    <div class="space-y-2.5 mb-8">
      <p class="text-xs font-bold uppercase tracking-wider text-amber-400">Included Technical Capabilities:</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {service.subServices.slice(0, isPrimary ? 6 : 4).map((sub) => (
          <div class="flex items-start gap-2 text-xs font-medium text-slate-200 p-2 rounded-xl bg-slate-900/60 border border-slate-800/80">
            <svg class="w-4 h-4 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>{sub.title}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom CTA Row -->
  <div class="pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4">
    <a
      href={`/services/${service.slug}/`}
      class="text-xs sm:text-sm font-bold text-slate-300 hover:text-amber-400 transition-colors"
    >
      Explore 5-Step Process & FAQs →
    </a>

    <div class="flex items-center gap-2 w-full sm:w-auto">
      <WhatsAppButton
        location="lk"
        serviceName={service.title}
        customMessage={service.whatsappMessage}
        label={service.ctaText}
        variant={isPrimary ? 'primary' : 'outline'}
        size="md"
        searchKeyword={searchKeyword}
        placement={`service_card_${service.slug}`}
        class="w-full sm:w-auto"
      />
    </div>
  </div>
</div>
