---
import { SITE_CONFIG } from '../config/site';
import WhatsAppButton from './WhatsAppButton.astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#050e22] text-slate-400 border-t border-amber-500/20 pt-16 pb-12 select-none" id="main-footer">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 pb-16 border-b border-slate-800/80">
      
      <!-- Brand & Mission Column -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-3 group">
          <div class="p-1.5 rounded-xl bg-white/95 shadow-md flex items-center justify-center">
            <img
              src="/images/logo-icon.png"
              alt="Hive smart Logo"
              class="w-8 h-8 object-contain"
              width="32"
              height="32"
            />
          </div>
          <span class="text-2xl font-black text-white tracking-tight">
            Hive <span class="text-amber-400">smart</span>
          </span>
        </a>
        <p class="text-sm text-slate-300 leading-relaxed">
          {SITE_CONFIG.subTagline}
        </p>
        <p class="text-xs text-amber-500/90 font-medium">
          Serving ambitious businesses in Sri Lanka, Dubai / UAE, and worldwide with edge-delivered performance engineering.
        </p>
      </div>

      <!-- Services Navigation -->
      <div class="space-y-4">
        <p class="text-sm font-bold uppercase tracking-wider text-white">Services</p>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/services/website-development/" class="hover:text-amber-400 transition-colors flex items-center gap-1.5 font-medium text-amber-300">
              <span class="text-amber-400 text-xs">●</span> Website Development (Primary)
            </a>
          </li>
          <li>
            <a href="/services/cv-design/" class="hover:text-amber-400 transition-colors">
              ATS-Friendly CV Design
            </a>
          </li>
          <li>
            <a href="/services/mobile-app-development/" class="hover:text-amber-400 transition-colors">
              Mobile Application Development
            </a>
          </li>
          <li>
            <a href="/services/?q=wordpress-development" class="hover:text-amber-400 transition-colors">
              WordPress & CMS Solutions
            </a>
          </li>
          <li>
            <a href="/services/?q=ecommerce" class="hover:text-amber-400 transition-colors">
              Ecommerce & Online Stores
            </a>
          </li>
          <li>
            <a href="/services/?q=speed-optimization" class="hover:text-amber-400 transition-colors">
              Website Speed Optimization
            </a>
          </li>
        </ul>
      </div>

      <!-- Sri Lanka Regional Hub -->
      <div class="space-y-3.5">
        <div class="flex items-center gap-2">
          <span class="text-lg">🇱🇰</span>
          <p class="text-sm font-bold uppercase tracking-wider text-white">Sri Lanka Office</p>
        </div>
        <p class="text-sm text-slate-300 leading-snug">
          {SITE_CONFIG.contacts.sriLanka.fullAddress}
        </p>
        <div class="space-y-1.5 text-xs">
          <p class="text-slate-400">Direct Line: 
            <a href={`tel:${SITE_CONFIG.contacts.sriLanka.phoneTel}`} class="text-amber-400 hover:text-amber-300 font-semibold underline underline-offset-2 ml-1">
              {SITE_CONFIG.contacts.sriLanka.phoneDisplay}
            </a>
          </p>
          <p>
            <a href={SITE_CONFIG.contacts.sriLanka.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:text-sky-300 inline-flex items-center gap-1">
              <span>View on Google Maps</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </p>
        </div>
        <div class="pt-1">
          <WhatsAppButton
            location="lk"
            size="sm"
            variant="primary"
            label="Chat with Sri Lanka Hub"
            placement="footer"
          />
        </div>
      </div>

      <!-- Dubai UAE Regional Hub -->
      <div class="space-y-3.5">
        <div class="flex items-center gap-2">
          <span class="text-lg">🇦🇪</span>
          <p class="text-sm font-bold uppercase tracking-wider text-white">Dubai / UAE Office</p>
        </div>
        <p class="text-sm text-slate-300 leading-snug">
          {SITE_CONFIG.contacts.dubai.fullAddress}
        </p>
        <div class="space-y-1.5 text-xs">
          <p class="text-slate-400">Direct Line: 
            <a href={`tel:${SITE_CONFIG.contacts.dubai.phoneTel}`} class="text-amber-400 hover:text-amber-300 font-semibold underline underline-offset-2 ml-1">
              {SITE_CONFIG.contacts.dubai.phoneDisplay}
            </a>
          </p>
          <p>
            <a href={SITE_CONFIG.contacts.dubai.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:text-sky-300 inline-flex items-center gap-1">
              <span>View on Google Maps</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </p>
        </div>
        <div class="pt-1">
          <WhatsAppButton
            location="uae"
            size="sm"
            variant="secondary"
            label="Chat with Dubai Hub"
            placement="footer"
          />
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Direct Legal Disclaimer -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© {currentYear} {SITE_CONFIG.legalName}. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/about/" class="hover:text-amber-400 transition-colors">About Agency</a>
        <a href="/services/" class="hover:text-amber-400 transition-colors">All Services</a>
        <a href="/blog/" class="hover:text-amber-400 transition-colors">Blog & Insights</a>
        <a href="/contact/" class="hover:text-amber-400 transition-colors">Direct Contacts</a>
      </div>
    </div>
  </div>
</footer>
