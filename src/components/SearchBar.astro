---
interface Props {
  initialValue?: string;
  placeholder?: string;
  large?: boolean;
  class?: string;
}

const {
  initialValue = '',
  placeholder = 'Search services, web solutions, mobile apps, CV design...',
  large = true,
  class: className = ''
} = Astro.props;

// Quick suggested keywords for 1-click chip search
const suggestedPills = [
  'Website Development',
  'WordPress & WooCommerce',
  'Ecommerce Stores',
  'ATS Resume Design',
  'Mobile Apps (Flutter/iOS)',
  'Speed Optimization'
];
---

<div class={`w-full max-w-4xl mx-auto relative ${className}`} id="search-component">
  <form id="search-form" action="/services/" method="GET" class="relative group" role="search">
    <!-- Main Glowing Glass Search Bar Container -->
    <div
      class={`flex items-center w-full rounded-2xl md:rounded-3xl bg-[#081736]/90 backdrop-blur-2xl border-2 border-amber-500/30 hover:border-amber-500/60 focus-within:border-amber-400 focus-within:ring-4 focus-within:ring-amber-500/20 shadow-2xl shadow-amber-950/40 transition-all duration-300 ${
        large ? 'p-2 pl-4 md:pl-6' : 'p-1.5 pl-3'
      }`}
    >
      <!-- Search Glass Icon with subtle glow -->
      <div class="text-amber-400 transition-transform duration-300 group-hover:scale-110 flex-shrink-0 mr-3">
        <svg class={`${large ? 'w-6 h-6 md:w-7 md:h-7' : 'w-5 h-5'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <!-- Main Input Field -->
      <input
        type="search"
        name="q"
        id="search-input"
        value={initialValue}
        placeholder={placeholder}
        autocomplete="off"
        spellcheck="false"
        class={`w-full bg-transparent text-white placeholder-slate-400 focus:outline-none ${
          large ? 'text-base md:text-xl font-medium tracking-tight' : 'text-sm font-normal'
        }`}
        aria-label="Search HiveSmart services and digital solutions"
        aria-autocomplete="list"
        aria-controls="search-spotlight-box"
      />

      <!-- Keyboard shortcut pill hint -->
      <div class="hidden sm:flex items-center gap-1 mr-2 px-2.5 py-1 rounded-lg bg-slate-800/80 border border-slate-700/60 text-[11px] font-mono font-semibold text-slate-400 select-none">
        <span>⌘</span><span>K</span>
      </div>

      <!-- Clear Button (hidden by default) -->
      <button
        type="button"
        id="search-clear-btn"
        class="hidden text-slate-400 hover:text-amber-400 p-2 mr-1 transition-colors"
        aria-label="Clear search input"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Submit Action Button -->
      <button
        type="submit"
        id="search-submit-btn"
        class={`flex-shrink-0 inline-flex items-center justify-center font-black text-[#081736] bg-gradient-to-r from-amber-400 via-amber-500 to-amber-400 hover:from-amber-300 hover:to-amber-500 active:scale-95 rounded-xl md:rounded-2xl shadow-lg shadow-amber-500/20 transition-all duration-200 cursor-pointer ${
          large ? 'px-6 md:px-8 py-3.5 md:py-4 text-sm md:text-base' : 'px-4 py-2 text-sm'
        }`}
        aria-label="Execute search"
      >
        <span>Search</span>
        <svg class="w-4 h-4 ml-1.5 hidden md:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>

    <!-- Live Spotlight Search Result Popover Dropdown -->
    <div
      id="search-spotlight-box"
      class="hidden absolute left-0 right-0 top-full mt-3 z-50 rounded-3xl bg-[#081736]/95 backdrop-blur-2xl border-2 border-amber-500/40 shadow-2xl shadow-black/80 overflow-hidden transition-all duration-200 text-left"
      role="listbox"
    >
      <!-- Filter Category Tabs Header inside Search Box -->
      <div class="px-5 pt-4 pb-3 border-b border-slate-800/80 flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-1.5" id="search-filter-tabs">
          <button type="button" data-filter="all" class="search-tab-btn active px-3 py-1 rounded-full text-xs font-bold bg-amber-500 text-[#081736] transition-all">
            All Results
          </button>
          <button type="button" data-filter="web" class="search-tab-btn px-3 py-1 rounded-full text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800/80 transition-all">
            Web Dev
          </button>
          <button type="button" data-filter="cv" class="search-tab-btn px-3 py-1 rounded-full text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800/80 transition-all">
            CV Design
          </button>
          <button type="button" data-filter="app" class="search-tab-btn px-3 py-1 rounded-full text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800/80 transition-all">
            Mobile Apps
          </button>
          <button type="button" data-filter="blog" class="search-tab-btn px-3 py-1 rounded-full text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800/80 transition-all">
            Guides
          </button>
        </div>
        <span class="text-[11px] font-mono text-amber-400/80 hidden sm:inline" id="search-results-counter">
          Ready
        </span>
      </div>

      <!-- Scrollable Results Container -->
      <div class="max-h-[420px] overflow-y-auto p-3 space-y-1.5" id="search-results-scroll">
        <ul id="spotlight-results-list" class="space-y-1.5"></ul>
      </div>

      <!-- Quick Action Footer: WhatsApp Instant Contact -->
      <div class="px-5 py-3 bg-[#050e22]/90 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Need custom assistance?</span>
        </div>
        <div class="flex items-center gap-3">
          <a
            href="https://wa.me/94778091278?text=Hi%20HiveSmart%2C%20I'm%20looking%20for%20a%20digital%20solution."
            target="_blank"
            rel="noopener noreferrer"
            class="text-emerald-400 hover:text-emerald-300 font-bold inline-flex items-center gap-1 transition-colors"
          >
            <span>🇱🇰 LK WhatsApp</span>
          </a>
          <span class="text-slate-600">|</span>
          <a
            href="https://wa.me/971547713570?text=Hi%20HiveSmart%2C%20I'm%20looking%20for%20a%20digital%20solution."
            target="_blank"
            rel="noopener noreferrer"
            class="text-amber-400 hover:text-amber-300 font-bold inline-flex items-center gap-1 transition-colors"
          >
            <span>🇦🇪 Dubai WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </form>

  <!-- Popular / Trending Pills -->
  {large && (
    <div class="mt-4 flex flex-wrap items-center justify-center gap-2 select-none">
      <span class="text-xs font-bold text-amber-500/90 uppercase tracking-wider">Popular Searches:</span>
      {suggestedPills.map((pill) => (
        <button
          type="button"
          data-keyword={pill}
          class="trending-search-pill text-xs px-3.5 py-1.5 rounded-full bg-slate-900/80 border border-amber-500/20 hover:border-amber-500/60 hover:bg-amber-500/10 text-slate-200 hover:text-amber-300 transition-all cursor-pointer font-medium"
        >
          {pill}
        </button>
      ))}
    </div>
  )}
</div>

