  function initSpotlightSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const form = document.getElementById('search-form') as HTMLFormElement | null;
    const box = document.getElementById('search-spotlight-box');
    const list = document.getElementById('spotlight-results-list');
    const counter = document.getElementById('search-results-counter');
    const clearBtn = document.getElementById('search-clear-btn');
    const tabBtns = document.querySelectorAll('.search-tab-btn');
    const trendingPills = document.querySelectorAll('.trending-search-pill');

    if (!input || !form || !box || !list) return;

    let currentFilter: string = 'all';

    function highlightMatch(text: string, query: string): string {
      if (!query) return text;
      const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
      return text.replace(regex, '<span class="search-highlight">$1</span>');
    }

    function renderResults(query: string = '') {
      const q = query.trim().toLowerCase();

      let items = SEARCH_ITEMS;

      // Filter by category tab
      if (currentFilter !== 'all') {
        items = items.filter((item) => item.type === currentFilter);
      }

      // Filter by text query
      if (q) {
        items = items.filter((item) => {
          const matchTitle = item.title.toLowerCase().includes(q);
          const matchDesc = item.desc.toLowerCase().includes(q);
          const matchKeywords = item.keywords.some((k) => k.toLowerCase().includes(q));
          return matchTitle || matchDesc || matchKeywords;
        });
      }

      if (counter) {
        counter.textContent = `${items.length} ${items.length === 1 ? 'solution' : 'solutions'}`;
      }

      if (items.length === 0) {
        list!.innerHTML = `
          <li class="py-8 text-center px-4">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-400 flex items-center justify-center mx-auto text-2xl mb-3">
              🔍
            </div>
            <p class="text-sm font-bold text-white mb-1">No exact solution matches "${query}"</p>
            <p class="text-xs text-slate-400 mb-4 max-w-sm mx-auto">
              We engineer custom solutions for unique business needs. Chat with our engineers directly on WhatsApp:
            </p>
            <a
              href="https://wa.me/94778091278?text=Hi%20HiveSmart%2C%20I'm%20looking%20for%20a%20solution%20for%3A%20${encodeURIComponent(query)}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all shadow-md"
            >
              <span>💬 Ask Our Engineers on WhatsApp</span>
            </a>
          </li>
        `;
        box?.classList.remove('hidden');
        return;
      }

      list!.innerHTML = items
        .map((item, idx) => {
          const highlightedTitle = highlightMatch(item.title, q);
          const highlightedDesc = highlightMatch(item.desc, q);

          return `
            <li class="group/item rounded-2xl bg-slate-900/60 hover:bg-amber-500/10 border border-slate-800/80 hover:border-amber-500/40 p-3.5 transition-all duration-200" data-index="${idx}">
              <div class="flex items-start justify-between gap-3">
                <a href="${item.url}" class="flex items-start gap-3.5 flex-1 focus:outline-none">
                  <div class="w-10 h-10 rounded-xl bg-[#081736] border border-amber-500/30 flex items-center justify-center text-xl flex-shrink-0 group-hover/item:scale-110 transition-transform">
                    ${item.icon}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap mb-1">
                      <h4 class="text-sm font-bold text-white group-hover/item:text-amber-300 transition-colors">
                        ${highlightedTitle}
                      </h4>
                      <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full border ${item.badgeColor}">
                        ${item.badge}
                      </span>
                    </div>
                    <p class="text-xs text-slate-400 leading-relaxed line-clamp-2">
                      ${highlightedDesc}
                    </p>
                  </div>
                </a>

                <div class="flex items-center gap-2 flex-shrink-0 self-center">
                  ${
                    item.waUrl
                      ? `
                    <a
                      href="${item.waUrl}"
                      target="_blank"
                      rel="noopener noreferrer"
                      title="Quick WhatsApp Inquiry"
                      class="p-2 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/30 text-emerald-400 border border-emerald-500/30 transition-all text-xs font-bold inline-flex items-center gap-1"
                    >
                      <span>💬 Chat</span>
                    </a>
                  `
                      : ''
                  }
                  <a
                    href="${item.url}"
                    class="p-2 rounded-xl bg-slate-800 hover:bg-amber-500 hover:text-[#081736] text-amber-400 border border-slate-700 hover:border-amber-400 transition-all text-xs font-bold inline-flex items-center"
                    aria-label="View solution details"
                  >
                    <span>View →</span>
                  </a>
                </div>
              </div>
            </li>
          `;
        })
        .join('');

      box?.classList.remove('hidden');
    }

    // Input events
    input.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      if (val.trim()) {
        clearBtn?.classList.remove('hidden');
      } else {
        clearBtn?.classList.add('hidden');
      }
      renderResults(val);
    });

    input.addEventListener('focus', () => {
      renderResults(input.value);
    });

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      clearBtn.classList.add('hidden');
      renderResults('');
      input.focus();
    });

    // Category Tabs
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        tabBtns.forEach((b) => {
          b.classList.remove('active', 'bg-amber-500', 'text-[#081736]', 'font-bold');
          b.classList.add('text-slate-300', 'font-semibold');
        });
        const targetBtn = e.currentTarget as HTMLButtonElement;
        targetBtn.classList.add('active', 'bg-amber-500', 'text-[#081736]', 'font-bold');
        targetBtn.classList.remove('text-slate-300');
        currentFilter = targetBtn.getAttribute('data-filter') || 'all';
        renderResults(input.value);
      });
    });

    // Trending Search Pills
    trendingPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const kw = pill.getAttribute('data-keyword') || '';
        input.value = kw;
        clearBtn?.classList.remove('hidden');
        renderResults(kw);
        input.focus();
      });
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!form.contains(e.target as Node)) {
        box?.classList.add('hidden');
      }
    });

    // Keyboard shortcut (⌘K or Ctrl+K or /)
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        input.focus();
        input.select();
        renderResults(input.value);
      } else if (e.key === 'Escape') {
        box?.classList.add('hidden');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSpotlightSearch);
  } else {
    initSpotlightSearch();
  }
</script>
