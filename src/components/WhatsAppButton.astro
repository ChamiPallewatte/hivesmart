---
import { buildWhatsAppUrl, getWhatsAppTrackingAttributes } from '../lib/whatsapp/links';

interface Props {
  location?: 'lk' | 'uae';
  serviceName?: string;
  customMessage?: string;
  label?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'header';
  size?: 'sm' | 'md' | 'lg';
  fullWidth?: boolean;
  searchKeyword?: string;
  placement?: string;
  class?: string;
}

const {
  location = 'lk',
  serviceName,
  customMessage,
  label,
  variant = 'primary',
  size = 'md',
  fullWidth = false,
  searchKeyword,
  placement = 'content',
  class: className = ''
} = Astro.props;

const href = buildWhatsAppUrl({
  location,
  serviceName,
  customMessage,
  searchKeyword
});

const trackingAttrs = getWhatsAppTrackingAttributes({
  service: serviceName,
  location,
  placement
});

const defaultLabel =
  label || (location === 'uae' ? 'WhatsApp Dubai (+971)' : 'WhatsApp Sri Lanka (+94)');

// Styling variants
const variantClasses = {
  primary:
    'bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-900/20 border border-emerald-500/30',
  secondary:
    'bg-sky-600 hover:bg-sky-500 text-white shadow-lg shadow-sky-900/20 border border-sky-500/30',
  outline:
    'bg-transparent hover:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/40 hover:border-emerald-500',
  header:
    'bg-emerald-600 hover:bg-emerald-500 text-white shadow-sm font-semibold'
}[variant];

const sizeClasses = {
  sm: 'px-3.5 py-1.5 text-xs rounded-full gap-1.5',
  md: 'px-5 py-2.5 text-sm rounded-xl gap-2 font-medium',
  lg: 'px-6 py-3.5 text-base rounded-xl gap-2.5 font-semibold'
}[size];
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={`inline-flex items-center justify-center transition-all duration-200 active:scale-95 group select-none ${variantClasses} ${sizeClasses} ${fullWidth ? 'w-full' : ''} ${className}`}
  {...trackingAttrs}
  aria-label={`Contact on WhatsApp: ${defaultLabel}`}
>
  <!-- WhatsApp Icon SVG -->
  <svg
    class={`${size === 'sm' ? 'w-4 h-4' : 'w-5 h-5'} flex-shrink-0 fill-current text-white transition-transform group-hover:scale-110`}
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm0 18.06c-1.49 0-2.94-.4-4.22-1.15l-.3-.18-3.13.82.83-3.05-.2-.31a8.163 8.163 0 01-1.25-4.28c0-4.51 3.67-8.17 8.18-8.17 2.19 0 4.24.85 5.79 2.4 1.54 1.55 2.39 3.6 2.39 5.78 0 4.52-3.67 8.14-8.09 8.14zm4.49-6.13c-.25-.12-1.46-.72-1.69-.81-.22-.08-.39-.12-.55.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.55-1.33-.76-1.82c-.2-.48-.41-.41-.56-.42h-.48c-.17 0-.44.06-.67.31-.22.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.57.12.17 1.75 2.67 4.24 3.75.59.26 1.06.41 1.42.52.6.19 1.14.16 1.57.1.48-.07 1.46-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.12-.23-.19-.48-.31z" />
  </svg>
  <span>{defaultLabel}</span>
</a>

