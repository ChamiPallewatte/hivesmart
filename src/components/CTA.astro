---
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  headline?: string;
  description?: string;
  serviceName?: string;
}

const {
  headline = 'Have a Project in Mind?',
  description = "Let's discuss how we can help your business grow.",
  serviceName
} = Astro.props;
---

<section class="py-20 bg-[#061024] text-white relative overflow-hidden border-t border-amber-500/20" id="final-cta">
  <!-- Decorative Glow -->
  <div class="absolute inset-0 pointer-events-none opacity-25 bg-gradient-to-tr from-amber-500/20 via-orange-500/10 to-[#081736]"></div>
  
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-wider mb-6">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      Direct Inquiries • Instant Response
    </div>

    <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 text-white">
      {headline}
    </h2>

    <p class="text-lg text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
      {description}
    </p>

    <!-- WhatsApp Dual Region Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
      <WhatsAppButton
        location="lk"
        serviceName={serviceName}
        variant="primary"
        size="lg"
        fullWidth={true}
        label="WhatsApp Sri Lanka (+94)"
        placement="final_cta"
      />
      <WhatsAppButton
        location="uae"
        serviceName={serviceName}
        variant="secondary"
        size="lg"
        fullWidth={true}
        label="WhatsApp Dubai (+971)"
        placement="final_cta"
      />
    </div>

    <p class="text-xs text-amber-400/80 mt-6 font-medium">
      No long contact forms or delayed emails. Chat directly with senior engineers right now.
    </p>
  </div>
</section>
