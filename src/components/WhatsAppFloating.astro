---
import { SITE_CONFIG } from '../config/site';
import { buildWhatsAppUrl, getWhatsAppTrackingAttributes } from '../lib/whatsapp/links';

const lkUrl = buildWhatsAppUrl({ location: 'lk', placement: 'floating_widget' });
const uaeUrl = buildWhatsAppUrl({ location: 'uae', placement: 'floating_widget' });

const lkTracking = getWhatsAppTrackingAttributes({ location: 'lk', placement: 'floating_popup' });
const uaeTracking = getWhatsAppTrackingAttributes({ location: 'uae', placement: 'floating_popup' });
---

<!-- Floating WhatsApp Lead Generation Center -->
<aside class="fixed bottom-6 right-6 z-50 flex flex-col items-end print:hidden select-none" id="whatsapp-floating-hub" aria-label="WhatsApp Quick Contact">
  <!-- Interactive Popover Menu -->
  <div
    id="wa-popup-menu"
    class="hidden mb-3 w-72 rounded-2xl bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl p-4 shadow-2xl border border-slate-200/80 dark:border-slate-800 transition-all duration-300 origin-bottom-right"
    role="dialog"
    aria-label="Select WhatsApp Contact Hub"
  >
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100 dark:border-slate-800">
      <div class="flex items-center gap-2">
        <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-800 dark:text-slate-200">Instant WhatsApp Chat</p>
      </div>
      <button
        id="wa-popup-close"
        class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1 rounded-lg"
        aria-label="Close WhatsApp options"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <p class="text-xs text-slate-600 dark:text-slate-400 mb-3 leading-relaxed">
      Connect directly with our regional technical consultants for immediate project inquiries:
    </p>

    <div class="space-y-2">
      <!-- Sri Lanka Hub -->
      <a
        href={lkUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 hover:bg-emerald-50 dark:bg-slate-800/60 dark:hover:bg-slate-800 border border-slate-200/60 dark:border-slate-700/60 hover:border-emerald-300 dark:hover:border-emerald-500 transition-all group"
        {...lkTracking}
      >
        <div class="flex items-center gap-2.5">
          <span class="text-xl leading-none">🇱🇰</span>
          <div class="text-left">
            <p class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 transition-colors">Sri Lanka Hub</p>
            <p class="text-[11px] text-slate-500 dark:text-slate-400">{SITE_CONFIG.contacts.sriLanka.phoneDisplay}</p>
          </div>
        </div>
        <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400">Chat</span>
      </a>

      <!-- Dubai UAE Hub -->
      <a
        href={uaeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 hover:bg-emerald-50 dark:bg-slate-800/60 dark:hover:bg-slate-800 border border-slate-200/60 dark:border-slate-700/60 hover:border-emerald-300 dark:hover:border-emerald-500 transition-all group"
        {...uaeTracking}
      >
        <div class="flex items-center gap-2.5">
          <span class="text-xl leading-none">🇦🇪</span>
          <div class="text-left">
            <p class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 transition-colors">Dubai / UAE Hub</p>
            <p class="text-[11px] text-slate-500 dark:text-slate-400">{SITE_CONFIG.contacts.dubai.phoneDisplay}</p>
          </div>
        </div>
        <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400">Chat</span>
      </a>
    </div>
  </div>

  <!-- Main Floating Action Pill / Button -->
  <button
    id="wa-trigger-btn"
    class="flex items-center gap-2.5 px-4 py-3 bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white rounded-full shadow-2xl shadow-emerald-900/30 border border-emerald-400/40 transition-all duration-300 group"
    aria-expanded="false"
    aria-controls="wa-popup-menu"
    aria-label="Open WhatsApp live inquiry menu"
  >
    <span class="relative flex h-3 w-3">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
    </span>

    <svg class="w-6 h-6 fill-current text-white transition-transform group-hover:scale-110" viewBox="0 0 24 24">
      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm0 18.06c-1.49 0-2.94-.4-4.22-1.15l-.3-.18-3.13.82.83-3.05-.2-.31a8.163 8.163 0 01-1.25-4.28c0-4.51 3.67-8.17 8.18-8.17 2.19 0 4.24.85 5.79 2.4 1.54 1.55 2.39 3.6 2.39 5.78 0 4.52-3.67 8.14-8.09 8.14zm4.49-6.13c-.25-.12-1.46-.72-1.69-.81-.22-.08-.39-.12-.55.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.55-1.33-.76-1.82c-.2-.48-.41-.41-.56-.42h-.48c-.17 0-.44.06-.67.31-.22.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.57.12.17 1.75 2.67 4.24 3.75.59.26 1.06.41 1.42.52.6.19 1.14.16 1.57.1.48-.07 1.46-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.12-.23-.19-.48-.31z" />
    </svg>

    <span class="text-sm font-bold tracking-wide">WhatsApp</span>
  </button>
</aside>

<script>
  function setupFloatingHub() {
    const trigger = document.getElementById('wa-trigger-btn');
    const popup = document.getElementById('wa-popup-menu');
    const closeBtn = document.getElementById('wa-popup-close');

    if (!trigger || !popup) return;

    function toggle(open?: boolean) {
      const willOpen = open !== undefined ? open : popup?.classList.contains('hidden');
      if (willOpen) {
        popup?.classList.remove('hidden');
        trigger?.setAttribute('aria-expanded', 'true');
      } else {
        popup?.classList.add('hidden');
        trigger?.setAttribute('aria-expanded', 'false');
      }
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle();
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle(false);
    });

    document.addEventListener('click', (e) => {
      if (popup && !popup.contains(e.target as Node) && e.target !== trigger) {
        toggle(false);
      }
    });
  }

  // Support Astro view transitions or regular DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFloatingHub);
  } else {
    setupFloatingHub();
  }
</script>

