---
import { SITE_CONFIG } from '../config/site';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header
  class="sticky top-0 z-40 w-full backdrop-blur-2xl bg-[#050e22]/95 border-b border-amber-500/30 shadow-xl shadow-black/50 transition-all duration-300"
  id="main-header"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo with Official HS Hexagon Circuit Mark -->
      <a
        href="/"
        class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 rounded-xl p-1"
        aria-label="HiveSmart Agency Homepage"
      >
        <img
          src="/images/logo-icon.png"
          alt="HiveSmart Logo Mark"
          class="w-10 h-10 md:w-11 md:h-11 object-contain transition-transform duration-300 group-hover:scale-105 drop-shadow"
          width="44"
          height="44"
          loading="eager"
        />
        <div class="flex flex-col">
          <span class="text-xl md:text-2xl font-black tracking-tight text-white group-hover:text-amber-400 transition-colors">
            Hive <span class="text-amber-400">smart</span>
          </span>
          <span class="text-[9px] uppercase tracking-widest font-extrabold text-amber-400/90 mt-0.5">
            Digital Agency • LK & UAE
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links & Quick Search -->
      <nav class="hidden md:flex items-center gap-1.5 lg:gap-2.5" aria-label="Main Navigation">
        {SITE_CONFIG.navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-3.5 py-2 rounded-xl text-sm font-bold transition-all duration-200 ${
              isActive(link.href)
                ? 'text-amber-300 bg-amber-500/20 border border-amber-500/40 shadow-sm'
                : 'text-slate-100 hover:text-amber-400 hover:bg-slate-800/80'
            }`}
          >
            {link.label}
          </a>
        ))}

        <!-- Header Quick Search Pill Trigger -->
        <button
          type="button"
          id="header-search-trigger"
          class="ml-2 flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#081736] border border-amber-500/40 text-xs font-bold text-amber-400 hover:text-white hover:border-amber-300 hover:bg-amber-500/20 transition-all cursor-pointer shadow-md"
          aria-label="Open Spotlight Search"
        >
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <span class="hidden lg:inline text-white">Search</span>
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-900 text-amber-400 border border-amber-500/30">⌘K</span>
        </button>
      </nav>

      <!-- Regional WhatsApp Contact Hub CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <!-- Sri Lanka WhatsApp Button -->
        <WhatsAppButton
          location="lk"
          variant="primary"
          size="sm"
          label="LK WhatsApp"
          placement="header"
        />

        <!-- Dubai WhatsApp Button -->
        <WhatsAppButton
          location="uae"
          variant="secondary"
          size="sm"
          label="Dubai WhatsApp"
          placement="header"
        />
      </div>

      <!-- Mobile Menu Trigger -->
      <div class="flex items-center gap-2 lg:hidden">
        <WhatsAppButton
          location="lk"
          variant="primary"
          size="sm"
          label="WhatsApp"
          placement="header_mobile"
        />

        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-2.5 rounded-xl text-white bg-slate-800/90 hover:bg-slate-700 border border-amber-500/30 focus:outline-none focus:ring-2 focus:ring-amber-400"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6 text-white" id="menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
          <svg class="w-6 h-6 hidden text-white" id="menu-icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Collapsible Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-amber-500/30 bg-[#081736]/98 backdrop-blur-2xl px-5 pt-4 pb-6 space-y-3 shadow-2xl"
  >
    <nav class="space-y-1.5" aria-label="Mobile Navigation">
      {SITE_CONFIG.navLinks.map((link) => (
        <a
          href={link.href}
          class={`block px-4 py-3 rounded-xl text-base font-bold transition-colors ${
            isActive(link.href)
              ? 'text-amber-400 bg-amber-500/20 border border-amber-500/40'
              : 'text-white hover:bg-slate-800 hover:text-amber-400'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Mobile Search Trigger -->
    <div class="pt-2">
      <button
        type="button"
        id="mobile-search-trigger"
        class="w-full flex items-center justify-between px-4 py-3 rounded-xl bg-slate-900 border border-amber-500/30 text-sm font-bold text-white hover:border-amber-400"
      >
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <span>Search Solutions...</span>
        </div>
        <span class="text-xs text-amber-400 font-mono">Spotlight</span>
      </button>
    </div>

    <!-- Mobile WhatsApp Buttons -->
    <div class="pt-4 border-t border-slate-800 space-y-2">
      <p class="text-xs font-black uppercase tracking-wider text-amber-400 px-1">Direct Consultant Lines</p>
      <WhatsAppButton
        location="lk"
        variant="primary"
        size="md"
        fullWidth={true}
        label="WhatsApp Sri Lanka (+94)"
        placement="mobile_menu"
      />
      <WhatsAppButton
        location="uae"
        variant="secondary"
        size="md"
        fullWidth={true}
        label="WhatsApp Dubai (+971)"
        placement="mobile_menu"
      />
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    function openSearch() {
      const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
      if (searchInput) {
        searchInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => {
          searchInput.focus();
        }, 300);
      } else {
        window.location.href = '/services/';
      }
    }

    // Spotlight search triggers
    document.getElementById('header-search-trigger')?.addEventListener('click', openSearch);
    document.getElementById('mobile-search-trigger')?.addEventListener('click', () => {
      menu?.classList.add('hidden');
      openSearch();
    });

    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconOpen?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeader);
  } else {
    setupHeader();
  }
</script>
