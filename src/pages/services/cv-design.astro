---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import CTA from '../../components/CTA.astro';
import { getServiceBySlug, SERVICES } from '../../config/services';
import { getServiceSchema } from '../../lib/seo/schema';

const service = getServiceBySlug('cv-design')!;
const relatedServices = SERVICES.filter((s) => s.slug !== 'cv-design');

const serviceSchema = getServiceSchema({
  title: service.title,
  description: service.shortDescription,
  slug: service.slug
});

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: 'CV Design', url: '/services/cv-design/' }
];
---

<BaseLayout
  title="ATS-Friendly CV Design Sri Lanka & Dubai | Executive Resume Writing"
  description="ATS-compliant, executive-grade CV and resume design for high-paying roles in Dubai, UAE, and international firms. 100% ATS-scanner parsable, fast 48h delivery."
  keywords={service.keywords}
  structuredData={serviceSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="max-w-4xl mx-auto text-center my-10 md:my-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-600 dark:text-emerald-400 text-xs font-extrabold uppercase tracking-widest mb-6">
        Career Advancement Architecture
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.1] mb-6">
        ATS-Friendly CV Design <span class="text-gradient">That Passes Scanners & Wins Interviews</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed mb-8">
        Engineered specifically for competitive corporate roles in Dubai, Abu Dhabi, Sri Lanka, and global markets. 100% machine-parsable, typographically pristine.
      </p>

      <!-- Primary Action Row -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <WhatsAppButton
          location="lk"
          serviceName={service.title}
          customMessage={service.whatsappMessage}
          label="Order CV via WhatsApp (LK)"
          variant="primary"
          size="lg"
          placement="cv_hero"
        />
        <WhatsAppButton
          location="uae"
          serviceName={service.title}
          customMessage={service.whatsappMessage}
          label="Order CV via WhatsApp (Dubai)"
          variant="secondary"
          size="lg"
          placement="cv_hero"
        />
      </div>
    </header>

    <!-- Visual Mockup -->
    <div class="my-12 rounded-3xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-2xl bg-slate-950 max-w-4xl mx-auto">
      <img
        src="/images/services/cv-design.svg"
        alt="ATS-Friendly Executive CV Design Mockup"
        class="w-full h-auto object-cover max-h-[420px]"
        loading="eager"
      />
    </div>

    <!-- Core CV Solutions -->
    <section class="py-16">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Our Services</span>
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
          Precision Resume Engineering
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {service.subServices.map((sub) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">{sub.title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-4">{sub.shortDesc}</p>
              <ul class="space-y-1.5 mb-6">
                {sub.features.map((feat) => (
                  <li class="text-xs text-slate-700 dark:text-slate-300 flex items-center gap-2 font-medium">
                    <svg class="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
              <WhatsAppButton
                location="lk"
                serviceName={sub.title}
                label="Get Started on WhatsApp"
                variant="outline"
                size="sm"
                fullWidth={true}
                placement={`cv_subservice_${sub.title}`}
              />
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Why Choose ATS Engineering -->
    <section class="py-16 bg-slate-50 dark:bg-slate-900/40 rounded-3xl p-8 sm:p-12 my-8 border border-slate-200/60 dark:border-slate-800">
      <div class="max-w-3xl mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">The ATS Advantage</span>
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
          Why Job Seekers Fail with Standard Graphic Templates
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {service.benefits.map((b) => (
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-lg flex-shrink-0 mt-1">
              ✓
            </div>
            <div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">{b.title}</h3>
              <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{b.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Process -->
    <section class="py-16">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400">Step-by-Step</span>
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
          How Our 48-Hour CV Service Works
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
        {service.process.map((p) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col justify-between">
            <div>
              <span class="text-3xl font-black text-slate-200 dark:text-slate-800 block mb-3">0{p.step}</span>
              <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">{p.title}</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQs -->
    <section class="py-16 border-t border-slate-200 dark:border-slate-800">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white">CV Design FAQs</h2>
      </div>

      <div class="max-w-3xl mx-auto space-y-4">
        {service.faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2 flex items-start gap-2">
              <span class="text-emerald-500 font-black">Q.</span>
              <span>{faq.question}</span>
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed pl-6">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Related Services -->
    <section class="py-12 border-t border-slate-200 dark:border-slate-800">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Other Services You May Need</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {relatedServices.map((rel) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-between">
            <div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white">{rel.title}</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">{rel.tagline}</p>
            </div>
            <a href={`/services/${rel.slug}/`} class="text-xs font-bold text-sky-600 dark:text-sky-400 hover:underline">
              View Service →
            </a>
          </div>
        ))}
      </div>
    </section>

  </div>

  <CTA
    headline="Land Your Dream Job in Dubai or Globally"
    description="Send your current resume on WhatsApp for a fast, free evaluation."
    serviceName="CV Design"
  />
</BaseLayout>

