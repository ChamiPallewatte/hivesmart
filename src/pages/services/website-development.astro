---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import CTA from '../../components/CTA.astro';
import { getServiceBySlug, SERVICES } from '../../config/services';
import { getServiceSchema } from '../../lib/seo/schema';

const service = getServiceBySlug('website-development')!;
const relatedServices = SERVICES.filter((s) => s.slug !== 'website-development');

const serviceSchema = getServiceSchema({
  title: service.title,
  description: service.shortDescription,
  slug: service.slug
});

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: 'Website Development', url: '/services/website-development/' }
];
---

<BaseLayout
  title="Website Development Sri Lanka & Dubai | High-Performance Web Agency"
  description="Premier website development services in Sri Lanka and Dubai. Custom web platforms, WordPress, Ecommerce, and high-speed web engineering built to generate WhatsApp inquiries."
  keywords={service.keywords}
  structuredData={serviceSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="max-w-4xl mx-auto text-center my-10 md:my-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/15 border border-amber-500/40 text-amber-300 text-xs font-black uppercase tracking-widest mb-6">
        ⭐ Primary Agency Specialization
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
        Custom Website Development That <span class="text-gradient-gold">Converts Traffic Into Inquiries</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-200 leading-relaxed mb-8 font-normal">
        We architect high-performance, conversion-engineered digital platforms for forward-thinking enterprises in Sri Lanka, Dubai, and international markets.
      </p>

      <!-- Primary Action Row -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <WhatsAppButton
          location="lk"
          serviceName={service.title}
          customMessage={service.whatsappMessage}
          label="Discuss Website on WhatsApp (LK)"
          variant="primary"
          size="lg"
          placement="service_page_hero"
        />
        <WhatsAppButton
          location="uae"
          serviceName={service.title}
          customMessage={service.whatsappMessage}
          label="Discuss on WhatsApp (Dubai)"
          variant="secondary"
          size="lg"
          placement="service_page_hero"
        />
      </div>
    </header>

    <!-- Visual Banner Mockup -->
    <div class="my-12 rounded-3xl overflow-hidden border border-amber-500/30 shadow-2xl bg-[#081736] max-w-5xl mx-auto">
      <img
        src="/images/services/web-dev.svg"
        alt="HiveSmart Custom Website Development Architecture"
        class="w-full h-auto object-cover max-h-[480px]"
        loading="eager"
      />
    </div>

    <!-- Detailed Sub-Services Grid (10 Core Disciplines) -->
    <section class="py-16">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-black uppercase tracking-widest text-amber-400">Comprehensive Solutions</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">
          Specialized Website Development Solutions
        </h2>
        <p class="text-slate-300 mt-2 text-sm leading-relaxed">
          Every project is built specifically to address your unique business model, customer acquisition strategy, and brand aspirations.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {service.subServices.map((sub) => (
          <div class="p-6 rounded-3xl bg-[#081736] border border-amber-500/25 shadow-xl hover:border-amber-400 transition-all flex flex-col justify-between card-glow-hover">
            <div>
              <h3 class="text-lg font-black text-white mb-2">
                {sub.title}
              </h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-4 font-normal">
                {sub.shortDesc}
              </p>
              <ul class="space-y-2 mb-6">
                {sub.features.map((feat) => (
                  <li class="text-xs text-slate-200 flex items-center gap-2 font-medium">
                    <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="pt-4 border-t border-slate-800">
              <WhatsAppButton
                location="lk"
                serviceName={sub.title}
                label="Inquire via WhatsApp"
                variant="outline"
                size="sm"
                fullWidth={true}
                placement={`subservice_${sub.title}`}
              />
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="py-16 bg-[#081736]/80 rounded-3xl p-8 sm:p-12 my-8 border border-amber-500/25">
      <div class="max-w-3xl mb-10">
        <span class="text-xs font-black uppercase tracking-widest text-emerald-400">Competitive Edge</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">
          Why Businesses in Sri Lanka & Dubai Choose HiveSmart
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {service.benefits.map((b) => (
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-2xl bg-amber-500/15 text-amber-400 border border-amber-500/30 flex items-center justify-center font-bold text-lg flex-shrink-0 mt-1">
              ✓
            </div>
            <div>
              <h3 class="text-lg font-bold text-white mb-1">{b.title}</h3>
              <p class="text-sm text-slate-300 leading-relaxed font-normal">{b.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 5-Step Development Process -->
    <section class="py-16">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-black uppercase tracking-widest text-amber-400">Methodology</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">
          Our 5-Step Web Engineering Lifecycle
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
        {service.process.map((step) => (
          <div class="p-6 rounded-2xl bg-[#081736] border border-slate-800 hover:border-amber-500/40 transition-colors flex flex-col justify-between">
            <div>
              <span class="text-2xl font-black font-mono text-amber-400">0{step.step}</span>
              <h3 class="text-base font-bold text-white mt-2 mb-2">{step.title}</h3>
              <p class="text-xs text-slate-300 leading-relaxed font-normal">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQs Section -->
    <section class="py-16 max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-black uppercase tracking-widest text-amber-400">Questions Answered</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">
          Frequently Asked Questions
        </h2>
      </div>

      <div class="space-y-4">
        {service.faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-[#081736] border border-slate-800">
            <h3 class="text-base font-bold text-white mb-2">{faq.question}</h3>
            <p class="text-sm text-slate-300 leading-relaxed font-normal">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Related Services -->
    <section class="py-16 border-t border-slate-800">
      <div class="text-center mb-10">
        <h2 class="text-2xl font-black text-white">Other Core Specializations</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {relatedServices.map((rel) => (
          <div class="p-6 rounded-2xl bg-[#081736] border border-amber-500/25 flex flex-col justify-between">
            <div>
              <span class="text-xs font-bold uppercase text-amber-400">{rel.badge}</span>
              <h3 class="text-xl font-bold text-white mt-1 mb-2">{rel.title}</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">{rel.shortDescription}</p>
            </div>
            <a
              href={`/services/${rel.slug}/`}
              class="text-xs font-bold text-amber-400 hover:text-amber-300 inline-flex items-center gap-1"
            >
              <span>Explore {rel.title}</span>
              <span>→</span>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom WhatsApp Lead CTA -->
    <CTA
      headline="Ready for a High-Converting Website?"
      description="Connect directly with our technical consultants in Sri Lanka and Dubai to discuss your business website."
      serviceName="Website Development"
    />
  </div>
</BaseLayout>
