---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import CTA from '../../components/CTA.astro';
import { getServiceBySlug, SERVICES } from '../../config/services';
import { getServiceSchema } from '../../lib/seo/schema';

const service = getServiceBySlug('mobile-app-development')!;
const relatedServices = SERVICES.filter((s) => s.slug !== 'mobile-app-development');

const serviceSchema = getServiceSchema({
  title: service.title,
  description: service.shortDescription,
  slug: service.slug
});

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: 'Mobile App Development', url: '/services/mobile-app-development/' }
];
---

<BaseLayout
  title="Mobile App Development Sri Lanka & Dubai | iOS, Android & Flutter"
  description="High-performance custom mobile application development across Sri Lanka and Dubai. Native iOS, Android, and cross-platform Flutter mobile solutions built for scale."
  keywords={service.keywords}
  structuredData={serviceSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="max-w-4xl mx-auto text-center my-10 md:my-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-sky-500/15 border border-sky-500/40 text-sky-300 text-xs font-black uppercase tracking-widest mb-6">
        Mobile Engineering Excellence
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-white leading-[1.1] mb-6">
        Custom Mobile Apps <span class="text-gradient-gold">Engineered for Seamless Performance</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-200 leading-relaxed mb-8 font-normal">
        From concept to the Apple App Store and Google Play Store. We develop high-speed, secure mobile applications for businesses in Sri Lanka, Dubai, and worldwide.
      </p>

      <!-- Primary Action Row -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <WhatsAppButton
          location="lk"
          serviceName={service.title}
          customMessage={service.whatsappMessage}
          label="Discuss Mobile App (LK)"
          variant="primary"
          size="lg"
          placement="app_hero"
        />
        <WhatsAppButton
          location="uae"
          serviceName={service.title}
          customMessage={service.whatsappMessage}
          label="Discuss Mobile App (Dubai)"
          variant="secondary"
          size="lg"
          placement="app_hero"
        />
      </div>
    </header>

    <!-- Visual Mockup -->
    <div class="my-12 rounded-3xl overflow-hidden border border-amber-500/30 shadow-2xl bg-[#081736] max-w-4xl mx-auto">
      <img
        src="/images/services/mobile-app.svg"
        alt="Mobile App Development Architecture"
        class="w-full h-auto object-cover max-h-[420px]"
        loading="eager"
      />
    </div>

    <!-- Core App Solutions -->
    <section class="py-16">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-black uppercase tracking-widest text-sky-400">Our Services</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">
          Full-Stack Mobile Capabilities
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {service.subServices.map((sub) => (
          <div class="p-6 rounded-3xl bg-[#081736] border border-amber-500/25 shadow-xl hover:border-amber-400 transition-all flex flex-col justify-between card-glow-hover">
            <div>
              <h3 class="text-lg font-black text-white mb-2">{sub.title}</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-4 font-normal">{sub.shortDesc}</p>
              <ul class="space-y-2 mb-6">
                {sub.features.map((feat) => (
                  <li class="text-xs text-slate-200 flex items-center gap-2 font-medium">
                    <svg class="w-4 h-4 text-sky-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="pt-4 border-t border-slate-800">
              <WhatsAppButton
                location="lk"
                serviceName={sub.title}
                label="Inquire on WhatsApp"
                variant="outline"
                size="sm"
                fullWidth={true}
                placement={`subservice_app_${sub.title}`}
              />
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="py-16 bg-[#081736]/80 rounded-3xl p-8 sm:p-12 my-8 border border-amber-500/25">
      <div class="max-w-3xl mb-10">
        <span class="text-xs font-black uppercase tracking-widest text-sky-400">The HiveSmart Difference</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">
          Engineered for 60fps Native Performance
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {service.benefits.map((b) => (
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-2xl bg-sky-500/15 text-sky-400 border border-sky-500/30 flex items-center justify-center font-bold text-lg flex-shrink-0 mt-1">
              ✓
            </div>
            <div>
              <h3 class="text-lg font-bold text-white mb-1">{b.title}</h3>
              <p class="text-sm text-slate-300 leading-relaxed font-normal">{b.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Process -->
    <section class="py-16">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-black uppercase tracking-widest text-amber-400">Lifecycle</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">
          Our Mobile Engineering Process
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        {service.process.map((step) => (
          <div class="p-6 rounded-2xl bg-[#081736] border border-slate-800 flex flex-col justify-between">
            <div>
              <span class="text-2xl font-black font-mono text-sky-400">0{step.step}</span>
              <h3 class="text-base font-bold text-white mt-2 mb-2">{step.title}</h3>
              <p class="text-xs text-slate-300 leading-relaxed font-normal">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQs Section -->
    <section class="py-16 max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-black uppercase tracking-widest text-amber-400">FAQs</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white mt-1">
          Mobile App Development Questions Answered
        </h2>
      </div>

      <div class="space-y-4">
        {service.faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-[#081736] border border-slate-800">
            <h3 class="text-base font-bold text-white mb-2">{faq.question}</h3>
            <p class="text-sm text-slate-300 leading-relaxed font-normal">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <CTA
      headline="Have a Mobile App Idea?"
      description="Connect directly with our senior software engineers in Sri Lanka and Dubai to scope your mobile app."
      serviceName="Mobile App Development"
    />
  </div>
</BaseLayout>
