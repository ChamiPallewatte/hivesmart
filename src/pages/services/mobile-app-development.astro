---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import CTA from '../../components/CTA.astro';
import { getServiceBySlug, SERVICES } from '../../config/services';
import { getServiceSchema } from '../../lib/seo/schema';

const service = getServiceBySlug('mobile-app-development')!;
const relatedServices = SERVICES.filter((s) => s.slug !== 'mobile-app-development');

const serviceSchema = getServiceSchema({
  title: service.title,
  description: service.shortDescription,
  slug: service.slug
});

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: 'Mobile Application Development', url: '/services/mobile-app-development/' }
];
---

<BaseLayout
  title="Mobile App Development Sri Lanka & Dubai | iOS & Android Apps"
  description="Custom mobile application development in Sri Lanka and Dubai. Flutter, React Native, Swift iOS, and Kotlin Android apps engineered for rapid performance and store approval."
  keywords={service.keywords}
  structuredData={serviceSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="max-w-4xl mx-auto text-center my-10 md:my-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-sky-50 dark:bg-sky-950/60 border border-sky-200 dark:border-sky-800 text-sky-600 dark:text-sky-400 text-xs font-extrabold uppercase tracking-widest mb-6">
        Mobile Engineering Excellence
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.1] mb-6">
        High-Performance iOS & Android <span class="text-gradient">Mobile Applications</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed mb-8">
        From startup MVPs to enterprise internal tools. We engineer intuitive, fluid 60fps mobile applications with scalable cloud backends.
      </p>

      <!-- Primary Action Row -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <WhatsAppButton
          location="lk"
          serviceName={service.title}
          customMessage={service.whatsappMessage}
          label="Discuss App Idea on WhatsApp (LK)"
          variant="primary"
          size="lg"
          placement="mobile_hero"
        />
        <WhatsAppButton
          location="uae"
          serviceName={service.title}
          customMessage={service.whatsappMessage}
          label="Discuss on WhatsApp (Dubai)"
          variant="secondary"
          size="lg"
          placement="mobile_hero"
        />
      </div>
    </header>

    <!-- Visual Mockup -->
    <div class="my-12 rounded-3xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-2xl bg-slate-950 max-w-4xl mx-auto">
      <img
        src="/images/services/mobile-app.svg"
        alt="HiveSmart Mobile Application Architecture"
        class="w-full h-auto object-cover max-h-[420px]"
        loading="eager"
      />
    </div>

    <!-- Core Mobile Offerings -->
    <section class="py-16">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400">Mobile Capabilities</span>
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
          End-to-End Mobile App Development
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {service.subServices.map((sub) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">{sub.title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-4">{sub.shortDesc}</p>
              <ul class="space-y-1.5 mb-6">
                {sub.features.map((feat) => (
                  <li class="text-xs text-slate-700 dark:text-slate-300 flex items-center gap-2 font-medium">
                    <svg class="w-3.5 h-3.5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
              <WhatsAppButton
                location="lk"
                serviceName={sub.title}
                label="Discuss on WhatsApp"
                variant="outline"
                size="sm"
                fullWidth={true}
                placement={`mobile_subservice_${sub.title}`}
              />
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Benefits -->
    <section class="py-16 bg-slate-50 dark:bg-slate-900/40 rounded-3xl p-8 sm:p-12 my-8 border border-slate-200/60 dark:border-slate-800">
      <div class="max-w-3xl mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400">Engineering Advantage</span>
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
          Enterprise Security, Speed & Full IP Ownership
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {service.benefits.map((b) => (
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center font-bold text-lg flex-shrink-0 mt-1">
              ✓
            </div>
            <div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">{b.title}</h3>
              <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{b.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Development Lifecycle -->
    <section class="py-16">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400">Methodology</span>
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
          Our 5-Stage Mobile Delivery Process
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
        {service.process.map((p) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col justify-between">
            <div>
              <span class="text-3xl font-black text-slate-200 dark:text-slate-800 block mb-3">0{p.step}</span>
              <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">{p.title}</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQs -->
    <section class="py-16 border-t border-slate-200 dark:border-slate-800">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white">Mobile Development FAQs</h2>
      </div>

      <div class="max-w-3xl mx-auto space-y-4">
        {service.faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2 flex items-start gap-2">
              <span class="text-sky-500 font-black">Q.</span>
              <span>{faq.question}</span>
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed pl-6">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Related Services -->
    <section class="py-12 border-t border-slate-200 dark:border-slate-800">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Complementary Agency Services</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {relatedServices.map((rel) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-between">
            <div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white">{rel.title}</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">{rel.tagline}</p>
            </div>
            <a href={`/services/${rel.slug}/`} class="text-xs font-bold text-sky-600 dark:text-sky-400 hover:underline">
              View Service →
            </a>
          </div>
        ))}
      </div>
    </section>

  </div>

  <CTA
    headline="Turn Your Mobile App Concept into Reality"
    description="Connect with our lead mobile architects on WhatsApp to discuss technical scoping."
    serviceName="Mobile Application Development"
  />
</BaseLayout>

