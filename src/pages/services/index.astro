---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchBar from '../../components/SearchBar.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import CTA from '../../components/CTA.astro';
import { SERVICES } from '../../config/services';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' }
];
---

<BaseLayout
  title="Digital Services | Web Development, ATS CV Design & Mobile Apps"
  description="Explore HiveSmart's conversion-driven digital capabilities: High-performance Website Development, ATS-compliant CV Design, and iOS/Android Mobile Applications."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Services Header & Search Bar -->
    <div class="text-center max-w-4xl mx-auto my-10 md:my-16">
      <span class="text-xs font-extrabold uppercase tracking-widest text-sky-600 dark:text-sky-400">
        Our Specializations
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 dark:text-white mt-2 mb-6 tracking-tight">
        Engineered for Speed, Authority & Inquiries
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-300 mb-8 leading-relaxed">
        Filter or explore our core disciplines below. Every service is equipped with direct WhatsApp lead channels to fast-track your business goals.
      </p>

      <!-- Active Interactive Search -->
      <div class="max-w-2xl mx-auto">
        <SearchBar large={false} placeholder="Filter services (e.g., WordPress, ATS CV, iOS app)..." />
      </div>
    </div>

    <!-- Live Search Filter Status Notification (Shown via client JS when ?q= exists) -->
    <div id="search-filter-banner" class="hidden mb-10 p-4 rounded-2xl bg-sky-50 dark:bg-sky-950/40 border border-sky-200 dark:border-sky-800 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-sm font-medium text-slate-800 dark:text-slate-200" id="search-filter-text">
          Showing matching services for keyword query
        </span>
      </div>
      <a href="/services/" class="text-xs font-bold text-sky-600 dark:text-sky-400 hover:underline">
        Reset Filter
      </a>
    </div>

    <!-- Detailed Services Breakdown -->
    <div class="space-y-16">
      {SERVICES.map((service, idx) => (
        <section
          id={service.slug}
          class={`service-detail-card scroll-mt-28 p-8 sm:p-12 rounded-3xl border transition-all duration-300 ${
            service.isPrimary
              ? 'bg-gradient-to-br from-sky-500/5 via-white to-white dark:from-slate-900 dark:via-slate-900 dark:to-slate-950 border-2 border-sky-500/50 shadow-2xl shadow-sky-900/10'
              : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 shadow-xl shadow-slate-900/5'
          }`}
          data-service-slug={service.slug}
          data-service-keywords={service.keywords.join(' ')}
        >
          <!-- Service Header -->
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-8 border-b border-slate-100 dark:border-slate-800">
            <div>
              <div class="flex items-center gap-3 mb-2">
                <span class="text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full bg-slate-900 text-white dark:bg-white dark:text-slate-900">
                  Service 0{idx + 1}
                </span>
                {service.isPrimary && (
                  <span class="text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full bg-emerald-500 text-white">
                    Primary Service
                  </span>
                )}
              </div>
              <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                <a href={`/services/${service.slug}/`} class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">
                  {service.title}
                </a>
              </h2>
              <p class="text-base font-semibold text-sky-600 dark:text-sky-400 mt-1">
                {service.tagline}
              </p>
            </div>

            <!-- Service Specific WhatsApp CTAs -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <WhatsAppButton
                location="lk"
                serviceName={service.title}
                customMessage={service.whatsappMessage}
                label={service.ctaText}
                variant="primary"
                size="md"
                placement={`services_overview_${service.slug}`}
              />
              <a
                href={`/services/${service.slug}/`}
                class="px-5 py-2.5 rounded-xl text-sm font-bold text-center border border-slate-300 dark:border-slate-700 hover:border-sky-500 dark:hover:border-sky-400 text-slate-700 dark:text-slate-300 hover:text-sky-600 transition-colors"
              >
                Full Specifications →
              </a>
            </div>
          </div>

          <!-- Description & Sub-services -->
          <div class="pt-8 space-y-8">
            <p class="text-slate-600 dark:text-slate-300 text-base sm:text-lg leading-relaxed max-w-4xl">
              {service.longDescription}
            </p>

            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-4">
                Specialized Sub-Services & Capabilities:
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {service.subServices.map((sub) => (
                  <div class="sub-service-item p-5 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/70 dark:border-slate-800 transition-all hover:border-sky-400">
                    <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-1.5 flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      {sub.title}
                    </h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed mb-3">
                      {sub.shortDesc}
                    </p>
                    <ul class="space-y-1">
                      {sub.features.map((feat) => (
                        <li class="text-[11px] text-slate-600 dark:text-slate-400 flex items-center gap-1.5">
                          <svg class="w-3 h-3 text-sky-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                          </svg>
                          <span>{feat}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>
  </div>

  <CTA
    headline="Discuss Your Project Direct on WhatsApp"
    description="Connect with our lead architects in Sri Lanka or Dubai right now."
  />
</BaseLayout>

<script>
  function applyQueryFilter() {
    const params = new URLSearchParams(window.location.search);
    const query = params.get('q');
    const banner = document.getElementById('search-filter-banner');
    const bannerText = document.getElementById('search-filter-text');
    const cards = document.querySelectorAll('.service-detail-card');

    if (!query || !query.trim()) return;

    const cleanQ = query.toLowerCase().trim();

    if (banner && bannerText) {
      bannerText.innerHTML = `Showing filtered results for: <strong class="text-sky-600 dark:text-sky-400">"${query}"</strong>`;
      banner.classList.remove('hidden');
    }

    let firstMatch: Element | null = null;

    cards.forEach((card) => {
      const keywords = card.getAttribute('data-service-keywords') || '';
      const slug = card.getAttribute('data-service-slug') || '';
      const text = card.textContent?.toLowerCase() || '';

      if (keywords.includes(cleanQ) || slug.includes(cleanQ) || text.includes(cleanQ)) {
        card.classList.remove('opacity-40');
        (card as HTMLElement).style.display = 'block';
        card.classList.add('ring-4', 'ring-sky-500/20');
        if (!firstMatch) firstMatch = card;
      } else {
        card.classList.add('opacity-40');
      }
    });

    if (firstMatch) {
      firstMatch.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applyQueryFilter);
  } else {
    applyQueryFilter();
  }
</script>

