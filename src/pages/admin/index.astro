    <!-- Interactive Tabs & Auto-Slug Script -->
    <script>
      function setupAdminUI() {
        // Tab switching
        const tabs = document.querySelectorAll('#studio-tabs .tab-btn');
        const contents = document.querySelectorAll('.tab-content');

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const target = tab.getAttribute('data-tab');
            if (!target) return;

            tabs.forEach((t) => {
              t.classList.remove('active', 'bg-amber-500', 'text-[#081736]');
              t.classList.add('text-slate-300');
            });
            tab.classList.add('active', 'bg-amber-500', 'text-[#081736]');
            tab.classList.remove('text-slate-300');

            contents.forEach((c) => {
              if (c.id === `tab-${target}`) {
                c.classList.remove('hidden');
              } else {
                c.classList.add('hidden');
              }
            });
          });
        });

        // Auto-slug generator on Title input
        const titleInput = document.getElementById('post-title') as HTMLInputElement | null;
        const slugInput = document.getElementById('post-slug') as HTMLInputElement | null;

        titleInput?.addEventListener('input', () => {
          if (slugInput && !slugInput.dataset.manual) {
            slugInput.value = titleInput.value
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/^-|-$/g, '');
          }
        });

        slugInput?.addEventListener('input', () => {
          slugInput.dataset.manual = 'true';
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupAdminUI);
      } else {
        setupAdminUI();
      }
    </script>
