---
import { SITE_CONFIG } from '../../config/site';
import { SERVICES } from '../../config/services';
import { getAllPosts, type StaticBlogPost } from '../../lib/database/initial-posts';
import { getBlogArticles, createBlogPost, deleteBlogPost } from '../../lib/database/db';
import '../../styles/global.css';

export const prerender = false;

// Standard Astro cookie management
const adminSecret = import.meta.env.ADMIN_SECRET_KEY || 'default_admin_key';
let isAuthenticated = Astro.cookies.get('hivesmart_admin_auth')?.value === adminSecret;

let errorMessage = '';
let successMessage = '';

let d1Binding: any = null;
try {
  // @ts-ignore
  const cf = await import('cloudflare:workers');
  d1Binding = cf?.env?.DB;
} catch {}

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action');

    if (action === 'login') {
      const password = formData.get('password');
      const expectedPassword = import.meta.env.ADMIN_SESSION_PASSWORD || 'hivesmart2026';

      if (password === expectedPassword) {
        isAuthenticated = true;
        Astro.cookies.set('hivesmart_admin_auth', adminSecret, {
          httpOnly: true,
          path: '/admin',
          sameSite: 'strict',
          maxAge: 86400
        });
      } else {
        errorMessage = 'Invalid administrative password. Try hivesmart2026';
      }
    } else if (action === 'logout') {
      isAuthenticated = false;
      Astro.cookies.delete('hivesmart_admin_auth', {
        path: '/admin'
      });
    } else if (action === 'create_post' && isAuthenticated) {
      const title = String(formData.get('title') || '').trim();
      let slug = String(formData.get('slug') || '').trim();
      const categoryName = String(formData.get('categoryName') || 'Website Development').trim();
      const description = String(formData.get('description') || '').trim();
      const content = String(formData.get('content') || '').trim();
      const author = String(formData.get('author') || 'HiveSmart Team').trim();
      const readingTime = Number(formData.get('readingTime')) || 5;
      const tags = String(formData.get('tags') || '')
        .split(',')
        .map((t) => t.trim())
        .filter(Boolean);

      if (!title || !content) {
        errorMessage = 'Please provide both an article Title and Content.';
      } else {
        if (!slug) {
          slug = title
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, '');
        }

        await createBlogPost(
          {
            title,
            slug,
            categoryName,
            description: description || title,
            content,
            author,
            readingTime,
            tags
          },
          d1Binding
        );

        successMessage = `Article "${title}" published successfully! Accessible at /blog/${slug}/`;
      }
    } else if (action === 'delete_post' && isAuthenticated) {
      const slug = String(formData.get('slug') || '').trim();
      if (slug) {
        await deleteBlogPost(slug, d1Binding);
        successMessage = `Article with slug "${slug}" has been deleted.`;
      }
    }
  } catch (err: any) {
    errorMessage = `Action failed: ${err?.message || 'Server error'}`;
  }
}

// Retrieve articles
const posts = getAllPosts();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HiveSmart Admin & Content Studio</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="bg-[#050e22] text-slate-100 min-h-screen font-sans antialiased bg-honeycomb-pattern">
    
    {!isAuthenticated ? (
      <div class="min-h-screen flex items-center justify-center p-4">
        <div class="w-full max-w-md p-8 sm:p-10 rounded-3xl bg-[#081736]/90 border-2 border-amber-500/40 shadow-2xl backdrop-blur-2xl">
          <!-- Central Brand Logo -->
          <div class="flex items-center gap-3.5 mb-8">
            <div class="w-12 h-12 rounded-2xl bg-slate-900 border border-amber-500/40 flex items-center justify-center p-2 shadow-inner">
              <img src="/images/logo-icon.png" alt="HiveSmart Mark" class="w-full h-full object-contain" />
            </div>
            <div>
              <h1 class="text-xl font-black text-white tracking-tight">
                Hive <span class="text-amber-400">smart</span> Admin
              </h1>
              <p class="text-xs text-amber-400/90 font-mono">Content & Service Studio</p>
            </div>
          </div>

          {errorMessage && (
            <div class="mb-6 p-3.5 rounded-2xl bg-rose-950/80 border border-rose-800 text-rose-200 text-xs flex items-center gap-2">
              <span>⚠️</span>
              <span>{errorMessage}</span>
            </div>
          )}

          <form method="POST" class="space-y-5">
            <input type="hidden" name="action" value="login" />
            <div>
              <label for="password" class="block text-xs font-black uppercase tracking-wider text-slate-300 mb-2">
                Administrator Password Key
              </label>
              <input
                type="password"
                name="password"
                id="password"
                required
                placeholder="Enter admin password..."
                class="w-full px-4 py-3.5 rounded-2xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-2 focus:ring-amber-500/20 text-sm font-medium transition-all"
              />
            </div>
            <button
              type="submit"
              class="w-full py-4 rounded-2xl bg-gradient-to-r from-amber-400 via-amber-500 to-amber-400 hover:from-amber-300 hover:to-amber-500 font-black text-sm text-[#081736] transition-all shadow-lg shadow-amber-500/20 cursor-pointer active:scale-95"
            >
              Authenticate & Open Dashboard
            </button>
          </form>

          <div class="mt-8 pt-6 border-t border-slate-800 text-center">
            <p class="text-xs text-slate-400">
              Default Master Key: <code class="px-2 py-1 rounded bg-slate-900 text-amber-300 font-mono font-bold border border-slate-700">hivesmart2026</code>
            </p>
            <p class="text-[11px] text-slate-500 mt-2">
              Configurable via Cloudflare Worker environment variables (<code class="text-slate-400">ADMIN_SESSION_PASSWORD</code>).
            </p>
          </div>
        </div>
      </div>
    ) : (
      <div class="min-h-screen flex flex-col">
        <!-- Top Studio Header -->
        <header class="border-b border-amber-500/20 bg-[#081736]/90 backdrop-blur-xl px-6 py-4 flex items-center justify-between sticky top-0 z-40">
          <div class="flex items-center gap-4">
            <a href="/" class="flex items-center gap-2 group">
              <img src="/images/logo-icon.png" alt="Logo" class="w-8 h-8 object-contain" />
              <span class="text-lg font-black text-white">Hive <span class="text-amber-400">smart</span> Studio</span>
            </a>
            <span class="hidden sm:inline-flex text-[11px] px-2.5 py-0.5 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800 font-bold">
              ● Live Studio Mode
            </span>
          </div>

          <div class="flex items-center gap-3">
            <a href="/" target="_blank" class="text-xs font-bold text-slate-300 hover:text-amber-300 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 transition-colors">
              Public Site ↗
            </a>
            <form method="POST">
              <input type="hidden" name="action" value="logout" />
              <button type="submit" class="text-xs font-bold px-3 py-1.5 rounded-xl bg-rose-950/60 hover:bg-rose-900 text-rose-300 border border-rose-800/80 transition-colors cursor-pointer">
                Sign Out
              </button>
            </form>
          </div>
        </header>

        <!-- Studio Body Navigation & Main Content -->
        <main class="flex-1 max-w-7xl mx-auto w-full p-4 sm:p-6 lg:p-8 space-y-8">
          
          <!-- Alert feedback banners -->
          {successMessage && (
            <div class="p-4 rounded-2xl bg-emerald-950/90 border border-emerald-500/50 text-emerald-200 text-sm flex items-center justify-between shadow-lg">
              <div class="flex items-center gap-2">
                <span>✅</span>
                <span>{successMessage}</span>
              </div>
              <a href="/blog/" target="_blank" class="text-xs font-bold underline hover:text-white">View in Public Blog →</a>
            </div>
          )}

          {errorMessage && (
            <div class="p-4 rounded-2xl bg-rose-950/90 border border-rose-500/50 text-rose-200 text-sm flex items-center gap-2 shadow-lg">
              <span>⚠️</span>
              <span>{errorMessage}</span>
            </div>
          )}

          <!-- Studio Navigation Tabs Bar -->
          <div class="flex items-center gap-2 border-b border-slate-800 pb-2 overflow-x-auto" id="studio-tabs">
            <button type="button" data-tab="overview" class="tab-btn active px-4 py-2 rounded-2xl text-xs font-black uppercase tracking-wider bg-amber-500 text-[#081736] transition-all cursor-pointer">
              📊 Overview & System
            </button>
            <button type="button" data-tab="create-blog" class="tab-btn px-4 py-2 rounded-2xl text-xs font-black uppercase tracking-wider text-slate-300 hover:text-white hover:bg-slate-800 transition-all cursor-pointer">
              ✍️ Add New Blog Article
            </button>
            <button type="button" data-tab="manage-blogs" class="tab-btn px-4 py-2 rounded-2xl text-xs font-black uppercase tracking-wider text-slate-300 hover:text-white hover:bg-slate-800 transition-all cursor-pointer">
              📝 Published Articles ({posts.length})
            </button>
            <button type="button" data-tab="services-guide" class="tab-btn px-4 py-2 rounded-2xl text-xs font-black uppercase tracking-wider text-slate-300 hover:text-white hover:bg-slate-800 transition-all cursor-pointer">
              🛠️ Services & Offerings ({SERVICES.length})
            </button>
            <button type="button" data-tab="contacts" class="tab-btn px-4 py-2 rounded-2xl text-xs font-black uppercase tracking-wider text-slate-300 hover:text-white hover:bg-slate-800 transition-all cursor-pointer">
              📞 WhatsApp Channels
            </button>
          </div>

          <!-- TAB 1: OVERVIEW -->
          <div id="tab-overview" class="tab-content space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
              <div class="p-6 rounded-3xl bg-[#081736]/80 border border-amber-500/20 shadow-xl">
                <span class="text-xs uppercase font-extrabold text-amber-400">Database Engine</span>
                <p class="text-2xl font-black text-white mt-1">Cloudflare D1</p>
                <p class="text-xs text-emerald-400 mt-2 font-mono">SQLite Edge Storage Active</p>
              </div>
              <div class="p-6 rounded-3xl bg-[#081736]/80 border border-amber-500/20 shadow-xl">
                <span class="text-xs uppercase font-extrabold text-amber-400">Published Articles</span>
                <p class="text-2xl font-black text-white mt-1">{posts.length} Guides</p>
                <p class="text-xs text-sky-400 mt-2 font-mono">Auto-generated XML Sitemap</p>
              </div>
              <div class="p-6 rounded-3xl bg-[#081736]/80 border border-amber-500/20 shadow-xl">
                <span class="text-xs uppercase font-extrabold text-amber-400">Core Services</span>
                <p class="text-2xl font-black text-white mt-1">3 Disciplines</p>
                <p class="text-xs text-amber-300 mt-2 font-mono">Website Dev (Primary), CV, Apps</p>
              </div>
              <div class="p-6 rounded-3xl bg-[#081736]/80 border border-amber-500/20 shadow-xl">
                <span class="text-xs uppercase font-extrabold text-amber-400">Active Domains</span>
                <p class="text-xl font-black text-white mt-1">hivesmartpro.com</p>
                <p class="text-xs text-emerald-400 mt-2 font-mono">SSL & CDN Active</p>
              </div>
            </div>

            <div class="p-6 sm:p-8 rounded-3xl bg-[#081736]/60 border border-slate-800">
              <h2 class="text-xl font-black text-white mb-3">Quick Navigation & Operations</h2>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <button type="button" onclick="document.querySelector('[data-tab=create-blog]').click()" class="p-4 rounded-2xl bg-slate-900 border border-slate-800 hover:border-amber-500/50 text-left cursor-pointer transition-all">
                  <span class="text-2xl block mb-2">✍️</span>
                  <span class="text-sm font-bold text-white block">Create New Article</span>
                  <span class="text-xs text-slate-400">Write and publish directly to the live blog</span>
                </button>
                <a href="/sitemap.xml" target="_blank" class="p-4 rounded-2xl bg-slate-900 border border-slate-800 hover:border-amber-500/50 text-left transition-all">
                  <span class="text-2xl block mb-2">🗺️</span>
                  <span class="text-sm font-bold text-white block">View Live Sitemap.xml</span>
                  <span class="text-xs text-slate-400">Direct XML index for Google Search Console</span>
                </a>
                <a href="/services/" target="_blank" class="p-4 rounded-2xl bg-slate-900 border border-slate-800 hover:border-amber-500/50 text-left transition-all">
                  <span class="text-2xl block mb-2">🌐</span>
                  <span class="text-sm font-bold text-white block">View Public Services</span>
                  <span class="text-xs text-slate-400">Review search filters and WhatsApp links</span>
                </a>
              </div>
            </div>
          </div>

          <!-- TAB 2: CREATE BLOG POST -->
          <div id="tab-create-blog" class="tab-content hidden space-y-6">
            <div class="p-6 sm:p-8 rounded-3xl bg-[#081736]/80 border-2 border-amber-500/30 shadow-2xl">
              <div class="flex items-center justify-between mb-6">
                <div>
                  <h2 class="text-xl sm:text-2xl font-black text-white">Publish New Article or Technical Guide</h2>
                  <p class="text-xs text-slate-400 mt-1">Articles are saved to Cloudflare D1 and immediately indexed with Article Schema.</p>
                </div>
                <span class="text-xs font-mono px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold">
                  Instant Publication
                </span>
              </div>

              <form method="POST" class="space-y-6" id="create-post-form">
                <input type="hidden" name="action" value="create_post" />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="post-title" class="block text-xs font-black uppercase tracking-wider text-slate-300 mb-2">
                      Article Title *
                    </label>
                    <input
                      type="text"
                      id="post-title"
                      name="title"
                      required
                      placeholder="e.g. 10 Essential Factors for High-Converting Websites in Dubai"
                      class="w-full px-4 py-3.5 rounded-2xl bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 text-sm font-semibold"
                    />
                  </div>

                  <div>
                    <label for="post-slug" class="block text-xs font-black uppercase tracking-wider text-slate-300 mb-2">
                      URL Slug (Auto-generated) *
                    </label>
                    <div class="flex items-center rounded-2xl bg-slate-900 border border-slate-700 px-3">
                      <span class="text-xs text-slate-500 font-mono">/blog/</span>
                      <input
                        type="text"
                        id="post-slug"
                        name="slug"
                        placeholder="10-factors-high-converting-websites-dubai"
                        class="w-full px-2 py-3.5 bg-transparent text-amber-300 placeholder-slate-600 focus:outline-none text-sm font-mono"
                      />
                    </div>
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                  <div>
                    <label for="post-category" class="block text-xs font-black uppercase tracking-wider text-slate-300 mb-2">
                      Category
                    </label>
                    <select
                      id="post-category"
                      name="categoryName"
                      class="w-full px-4 py-3.5 rounded-2xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-amber-400 text-sm"
                    >
                      <option value="Website Development">Website Development</option>
                      <option value="CV Design">CV Design & ATS</option>
                      <option value="Mobile Applications">Mobile Applications</option>
                      <option value="Digital Strategy">Digital Strategy</option>
                      <option value="Speed Optimization">Speed Optimization</option>
                    </select>
                  </div>

                  <div>
                    <label for="post-author" class="block text-xs font-black uppercase tracking-wider text-slate-300 mb-2">
                      Author
                    </label>
                    <input
                      type="text"
                      id="post-author"
                      name="author"
                      value="HiveSmart Senior Technical Architect"
                      class="w-full px-4 py-3.5 rounded-2xl bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 text-sm"
                    />
                  </div>

                  <div>
                    <label for="post-reading" class="block text-xs font-black uppercase tracking-wider text-slate-300 mb-2">
                      Estimated Reading Time (Minutes)
                    </label>
                    <input
                      type="number"
                      id="post-reading"
                      name="readingTime"
                      value="5"
                      min="1"
                      max="30"
                      class="w-full px-4 py-3.5 rounded-2xl bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 text-sm"
                    />
                  </div>
                </div>

                <div>
                  <label for="post-desc" class="block text-xs font-black uppercase tracking-wider text-slate-300 mb-2">
                    Short Description / SEO Snippet *
                  </label>
                  <textarea
                    id="post-desc"
                    name="description"
                    rows="2"
                    required
                    placeholder="A concise summary of the article that appears on Google and in preview cards..."
                    class="w-full px-4 py-3 rounded-2xl bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 text-sm leading-relaxed"
                  ></textarea>
                </div>

                <div>
                  <label for="post-content" class="block text-xs font-black uppercase tracking-wider text-slate-300 mb-2">
                    Full Article Content (Markdown / HTML Supported) *
                  </label>
                  <p class="text-[11px] text-slate-400 mb-2">
                    Tip: Use <code class="text-amber-400 font-mono">## Heading 2</code>, <code class="text-amber-400 font-mono">### Heading 3</code>, and <code class="text-amber-400 font-mono">- Bullet points</code> for clean automatic styling.
                  </p>
                  <textarea
                    id="post-content"
                    name="content"
                    rows="10"
                    required
                    placeholder="## Introduction&#10;&#10;Write your in-depth guide here...&#10;&#10;### Key Takeaways&#10;- Point 1&#10;- Point 2"
                    class="w-full px-4 py-3.5 rounded-2xl bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 text-sm font-mono leading-relaxed"
                  ></textarea>
                </div>

                <div>
                  <label for="post-tags" class="block text-xs font-black uppercase tracking-wider text-slate-300 mb-2">
                    Tags (Comma-separated)
                  </label>
                  <input
                    type="text"
                    id="post-tags"
                    name="tags"
                    placeholder="Web Development, Dubai, Sri Lanka, SEO, Speed"
                    class="w-full px-4 py-3 rounded-2xl bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 text-sm"
                  />
                </div>

                <div class="pt-4 border-t border-slate-800 flex items-center justify-end gap-3">
                  <button
                    type="submit"
                    class="px-8 py-4 rounded-2xl bg-gradient-to-r from-amber-400 via-amber-500 to-amber-400 hover:from-amber-300 hover:to-amber-500 text-[#081736] font-black text-sm transition-all shadow-xl shadow-amber-500/20 active:scale-95 cursor-pointer"
                  >
                    🚀 Publish Article to Live Site
                  </button>
                </div>
              </form>
            </div>
          </div>

          <!-- TAB 3: MANAGE BLOGS -->
          <div id="tab-manage-blogs" class="tab-content hidden space-y-6">
            <div class="p-6 sm:p-8 rounded-3xl bg-[#081736]/80 border border-slate-800 shadow-2xl">
              <div class="flex items-center justify-between mb-6">
                <div>
                  <h2 class="text-xl font-black text-white">Live Published Articles ({posts.length})</h2>
                  <p class="text-xs text-slate-400">All articles are indexed, rendered with Article Schema, and include contextual WhatsApp conversion funnels.</p>
                </div>
                <button type="button" onclick="document.querySelector('[data-tab=create-blog]').click()" class="text-xs font-black px-4 py-2 rounded-xl bg-amber-500 text-[#081736] hover:bg-amber-400 transition-colors cursor-pointer">
                  + Add New Post
                </button>
              </div>

              <div class="overflow-x-auto rounded-2xl border border-slate-800">
                <table class="w-full text-left text-xs text-slate-300">
                  <thead class="bg-slate-900 text-slate-400 uppercase text-[10px] tracking-wider font-mono">
                    <tr>
                      <th class="p-4">Title & Slug</th>
                      <th class="p-4">Category</th>
                      <th class="p-4">Reading Time</th>
                      <th class="p-4">Status</th>
                      <th class="p-4 text-right">Actions</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-800 bg-[#081736]/50">
                    {posts.map((post) => (
                      <tr class="hover:bg-slate-800/40 transition-colors">
                        <td class="p-4">
                          <p class="font-bold text-white max-w-md truncate">{post.title}</p>
                          <p class="text-[11px] text-amber-400/80 font-mono mt-0.5">/blog/{post.slug}/</p>
                        </td>
                        <td class="p-4">
                          <span class="px-2.5 py-1 rounded-full bg-slate-800 text-slate-200 border border-slate-700 text-[11px] font-semibold">
                            {post.category.name}
                          </span>
                        </td>
                        <td class="p-4 font-mono">{post.readingTime} min</td>
                        <td class="p-4">
                          <span class="px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800 font-bold text-[10px]">
                            ● Published
                          </span>
                        </td>
                        <td class="p-4 text-right space-x-2">
                          <a
                            href={`/blog/${post.slug}/`}
                            target="_blank"
                            class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-amber-500 hover:text-[#081736] text-amber-400 font-bold transition-all text-xs"
                          >
                            View ↗
                          </a>
                          <form method="POST" class="inline-block" onsubmit="return confirm('Are you sure you want to delete this article?');">
                            <input type="hidden" name="action" value="delete_post" />
                            <input type="hidden" name="slug" value={post.slug} />
                            <button
                              type="submit"
                              class="px-2.5 py-1.5 rounded-lg bg-rose-950/60 hover:bg-rose-900 text-rose-300 font-bold transition-all text-xs cursor-pointer"
                            >
                              Delete
                            </button>
                          </form>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- TAB 4: SERVICES MANAGEMENT & GUIDE -->
          <div id="tab-services-guide" class="tab-content hidden space-y-6">
            <div class="p-6 sm:p-8 rounded-3xl bg-[#081736]/80 border border-slate-800 shadow-2xl space-y-6">
              <div>
                <h2 class="text-xl font-black text-white">Configured Service Pillars & Solutions</h2>
                <p class="text-xs text-slate-400 mt-1">Each service is defined with full SEO schemas, WhatsApp conversion funnels, and sub-services in <code class="text-amber-400">src/config/services.ts</code>.</p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {SERVICES.map((s) => (
                  <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 flex flex-col justify-between">
                    <div>
                      <div class="flex items-center justify-between mb-3">
