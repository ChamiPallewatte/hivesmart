---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { SITE_CONFIG } from '../config/site';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' }
];

const serviceOptions = [
  { name: 'Website Development', msg: SITE_CONFIG.whatsappTemplates.websiteDevelopment },
  { name: 'Professional CV Design', msg: SITE_CONFIG.whatsappTemplates.cvDesign },
  { name: 'Mobile App Development', msg: SITE_CONFIG.whatsappTemplates.mobileApp },
  { name: 'Ecommerce Website', msg: SITE_CONFIG.whatsappTemplates.ecommerce },
  { name: 'Speed Optimization', msg: SITE_CONFIG.whatsappTemplates.speedOptimization }
];
---

<BaseLayout
  title="Contact HiveSmart | Direct WhatsApp Inquiries for Sri Lanka & Dubai"
  description="Connect with HiveSmart directly via WhatsApp or phone. No tedious contact forms—instant, real-time consultation with our technical teams in Sri Lanka and Dubai."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="max-w-3xl mx-auto text-center my-10 md:my-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/40 text-emerald-300 text-xs font-black uppercase tracking-widest mb-6">
        Zero Form Friction • 100% Direct WhatsApp
      </div>

      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-white mb-6">
        Start Your Project In Seconds <span class="text-gradient-gold">Via WhatsApp</span>
      </h1>

      <p class="text-lg text-slate-200 leading-relaxed font-normal">
        We respect your time. Instead of slow email forms that get buried in inboxes, we provide direct WhatsApp and phone channels to our senior consultants.
      </p>
    </header>

    <!-- Two Main Regional Hub Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-12">
      
      <!-- 1. Sri Lanka Hub Card -->
      <div class="p-8 sm:p-10 rounded-3xl bg-[#081736] border-2 border-emerald-500/40 shadow-2xl flex flex-col justify-between card-glow-hover">
        <div>
          <div class="flex items-center justify-between pb-6 border-b border-slate-800 mb-6">
            <div class="flex items-center gap-3">
              <span class="text-4xl">🇱🇰</span>
              <div>
                <span class="text-xs font-black uppercase tracking-wider text-emerald-400">Regional Hub</span>
                <h2 class="text-2xl font-black text-white">Sri Lanka</h2>
              </div>
            </div>
            <span class="text-xs font-bold px-3 py-1 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800 font-mono">
              ● Active Now
            </span>
          </div>

          <div class="space-y-4 mb-8 text-sm">
            <div>
              <p class="text-xs font-black uppercase tracking-wider text-slate-400 mb-1">Office Location</p>
              <p class="font-bold text-white text-base">
                {SITE_CONFIG.contacts.sriLanka.fullAddress}
              </p>
            </div>

            <div>
              <p class="text-xs font-black uppercase tracking-wider text-slate-400 mb-1">Direct Phone Line</p>
              <a href={`tel:${SITE_CONFIG.contacts.sriLanka.phoneInternational}`} class="text-lg font-bold text-amber-400 hover:text-amber-300 transition-colors font-mono">
                {SITE_CONFIG.contacts.sriLanka.phoneDisplay}
              </a>
            </div>

            <div>
              <p class="text-xs font-black uppercase tracking-wider text-slate-400 mb-1">Operating Hours</p>
              <p class="text-slate-300 text-xs">
                {SITE_CONFIG.contacts.sriLanka.hours} (IST)
              </p>
            </div>
          </div>
        </div>

        <div class="pt-6 border-t border-slate-800 space-y-3">
          <WhatsAppButton
            location="lk"
            variant="primary"
            size="lg"
            fullWidth={true}
            label="Chat on Sri Lanka WhatsApp"
            placement="contact_page_lk"
          />
          <a
            href={`tel:${SITE_CONFIG.contacts.sriLanka.phoneInternational}`}
            class="w-full py-3.5 px-4 rounded-xl text-center text-sm font-bold border border-slate-700 hover:border-amber-400 text-slate-200 hover:text-amber-400 transition-colors block"
          >
            Direct Call: {SITE_CONFIG.contacts.sriLanka.phoneDisplay}
          </a>
        </div>
      </div>

      <!-- 2. Dubai / UAE Hub Card -->
      <div class="p-8 sm:p-10 rounded-3xl bg-[#081736] border-2 border-amber-500/40 shadow-2xl flex flex-col justify-between card-glow-hover">
        <div>
          <div class="flex items-center justify-between pb-6 border-b border-slate-800 mb-6">
            <div class="flex items-center gap-3">
              <span class="text-4xl">🇦🇪</span>
              <div>
                <span class="text-xs font-black uppercase tracking-wider text-amber-400">Regional Hub</span>
                <h2 class="text-2xl font-black text-white">Dubai / UAE</h2>
              </div>
            </div>
            <span class="text-xs font-bold px-3 py-1 rounded-full bg-amber-950 text-amber-300 border border-amber-800 font-mono">
              ● Active Now
            </span>
          </div>

          <div class="space-y-4 mb-8 text-sm">
            <div>
              <p class="text-xs font-black uppercase tracking-wider text-slate-400 mb-1">Office Location</p>
              <p class="font-bold text-white text-base">
                {SITE_CONFIG.contacts.dubai.fullAddress}
              </p>
            </div>

            <div>
              <p class="text-xs font-black uppercase tracking-wider text-slate-400 mb-1">Direct Phone Line</p>
              <a href={`tel:${SITE_CONFIG.contacts.dubai.phoneInternational}`} class="text-lg font-bold text-amber-400 hover:text-amber-300 transition-colors font-mono">
                {SITE_CONFIG.contacts.dubai.phoneDisplay}
              </a>
            </div>

            <div>
              <p class="text-xs font-black uppercase tracking-wider text-slate-400 mb-1">Operating Hours</p>
              <p class="text-slate-300 text-xs">
                {SITE_CONFIG.contacts.dubai.hours} (GST)
              </p>
            </div>
          </div>
        </div>

        <div class="pt-6 border-t border-slate-800 space-y-3">
          <WhatsAppButton
            location="uae"
            variant="secondary"
            size="lg"
            fullWidth={true}
            label="Chat on Dubai WhatsApp"
            placement="contact_page_uae"
          />
          <a
            href={`tel:${SITE_CONFIG.contacts.dubai.phoneInternational}`}
            class="w-full py-3.5 px-4 rounded-xl text-center text-sm font-bold border border-slate-700 hover:border-amber-400 text-slate-200 hover:text-amber-400 transition-colors block"
          >
            Direct Call: {SITE_CONFIG.contacts.dubai.phoneDisplay}
          </a>
        </div>
      </div>

    </div>

    <!-- Pre-Filled Topic Selector for Quick WhatsApp Inquiries -->
    <div class="my-16 p-8 sm:p-12 rounded-3xl bg-[#081736]/80 border border-amber-500/25">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h3 class="text-2xl font-black text-white">Select a Topic to Prefill Your WhatsApp Message</h3>
        <p class="text-slate-300 text-sm mt-2 font-normal">
          Click any service below to open WhatsApp with your chosen project details ready to send.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {serviceOptions.map((opt) => (
          <a
            href={`https://wa.me/94778091278?text=${encodeURIComponent(opt.msg)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-4 rounded-2xl bg-slate-900 border border-slate-800 hover:border-amber-400 hover:bg-slate-850 text-white font-bold text-sm transition-all group"
          >
            <span>{opt.name}</span>
            <span class="text-emerald-400 group-hover:translate-x-1 transition-transform">💬 →</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
