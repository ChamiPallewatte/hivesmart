---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CTA from '../components/CTA.astro';
import { SITE_CONFIG } from '../config/site';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About Us', url: '/about/' }
];
---

<BaseLayout
  title="About HiveSmart | Modern Digital Engineering Agency"
  description="Learn about HiveSmart: Our transparent development approach, engineering standards, and commitment to delivering conversion-driven web and mobile solutions."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero Header -->
    <header class="max-w-4xl mx-auto text-center my-10 md:my-16">
      <span class="text-xs font-black uppercase tracking-widest text-amber-400">
        About HiveSmart
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-white mt-2 mb-6">
        Modern Engineering Built Around <span class="text-gradient-gold">Real Business Outcomes</span>
      </h1>
      <p class="text-lg sm:text-xl text-slate-200 leading-relaxed max-w-3xl mx-auto font-normal">
        We are a dedicated software and digital solutions agency operating across Sri Lanka and Dubai. We bridge the gap between creative visual design and enterprise-level web performance.
      </p>
    </header>

    <!-- Core Purpose & Philosophy -->
    <section class="py-12 border-t border-slate-800">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <span class="text-xs font-black uppercase tracking-widest text-emerald-400">What We Do</span>
          <h2 class="text-3xl font-black text-white tracking-tight">
            Digital Experiences That Solve Commercial Challenges
          </h2>
          <p class="text-slate-200 leading-relaxed text-base font-normal">
            Too many businesses are sold bloated templates that fail on mobile phones, break after plugin updates, and produce zero inquiries. We take a fundamentally different approach.
          </p>
          <p class="text-slate-300 leading-relaxed text-base font-normal">
            Every platform we build is engineered with clean, modern frameworks, optimized for edge-delivery on Cloudflare, and structured around direct, frictionless WhatsApp conversion channels tailored for our core markets in Sri Lanka and the UAE.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-[#081736] text-white border border-amber-500/30 space-y-6 shadow-2xl">
          <h3 class="text-xl font-black text-amber-400">Our Core Principles</h3>
          <ul class="space-y-4 text-sm text-slate-200">
            <li class="flex items-start gap-3">
              <span class="text-emerald-400 font-bold text-base">✓</span>
              <span><strong>Sub-Second Speed:</strong> Websites should load instantly without frustrating visitors on mobile networks.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-400 font-bold text-base">✓</span>
              <span><strong>Radical Transparency:</strong> Clear milestones, documented codebases, and direct communication with lead architects.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-400 font-bold text-base">✓</span>
              <span><strong>Direct Conversions:</strong> Replacing slow, unresponded email contact forms with single-tap instant WhatsApp funnels.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-400 font-bold text-base">✓</span>
              <span><strong>Zero Lock-In:</strong> You own 100% of your code, repository, hosting account, and creative assets.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Regional Strategic Hubs -->
    <section class="py-16 border-t border-slate-800">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-black uppercase tracking-widest text-amber-400">Global Reach, Local Presence</span>
        <h2 class="text-3xl font-black text-white mt-1">
          Our Regional Strategy Hubs
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Sri Lanka Hub -->
        <div class="p-8 rounded-3xl bg-[#081736] border border-amber-500/25 shadow-xl flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="text-3xl">🇱🇰</span>
              <div>
                <h3 class="text-xl font-bold text-white">Sri Lanka Headquarters</h3>
                <p class="text-xs text-amber-400 font-mono">Software Engineering & Regional Delivery</p>
              </div>
            </div>
            <p class="text-sm text-slate-300 leading-relaxed mb-6 font-normal">
              Located in Kegalle, Sri Lanka, our primary technical delivery team architects high-speed web apps, custom CMS platforms, and ATS-compliant CV architectures with exceptional cost efficiency.
            </p>
            <div class="space-y-1.5 text-xs text-slate-300 border-t border-slate-800 pt-4 font-mono">
              <p>📍 Location: {SITE_CONFIG.contacts.sriLanka.fullAddress}</p>
              <p>📞 Phone: {SITE_CONFIG.contacts.sriLanka.phoneDisplay}</p>
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-800">
            <WhatsAppButton
              location="lk"
              variant="primary"
              size="md"
              fullWidth={true}
              label="Contact Sri Lanka Office"
              placement="about_lk"
            />
          </div>
        </div>

        <!-- Dubai UAE Hub -->
        <div class="p-8 rounded-3xl bg-[#081736] border border-amber-500/25 shadow-xl flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="text-3xl">🇦🇪</span>
              <div>
                <h3 class="text-xl font-bold text-white">Dubai / UAE Operations</h3>
                <p class="text-xs text-amber-400 font-mono">Commercial Strategy & GCC Consulting</p>
              </div>
            </div>
            <p class="text-sm text-slate-300 leading-relaxed mb-6 font-normal">
              Serving our Middle East corporate and startup clientele with bilingual technical consulting, high-ticket digital branding, and rapid WhatsApp business acquisition workflows.
            </p>
            <div class="space-y-1.5 text-xs text-slate-300 border-t border-slate-800 pt-4 font-mono">
              <p>📍 Location: {SITE_CONFIG.contacts.dubai.fullAddress}</p>
              <p>📞 Phone: {SITE_CONFIG.contacts.dubai.phoneDisplay}</p>
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-800">
            <WhatsAppButton
              location="uae"
              variant="secondary"
              size="md"
              fullWidth={true}
              label="Contact Dubai Office"
              placement="about_uae"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <CTA
      headline="Let's Build Something Exceptional"
      description="Chat with our senior engineers today to discover how custom digital architecture can accelerate your growth."
    />
  </div>
</BaseLayout>
