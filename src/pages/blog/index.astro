---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/BlogCard.astro';
import CTA from '../../components/CTA.astro';
import { getAllPosts } from '../../lib/database/initial-posts';

const posts = getAllPosts();
const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' }
];
---

<BaseLayout
  title="Digital Growth & Engineering Blog | HiveSmart Agency"
  description="Expert articles and technical guides on website development, ATS resume design, mobile app architecture, and conversion optimization in Sri Lanka and Dubai."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Blog Header -->
    <header class="max-w-3xl mx-auto text-center my-10 md:my-14">
      <span class="text-xs font-extrabold uppercase tracking-widest text-sky-600 dark:text-sky-400">
        Industry Insights & Engineering
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mt-2 mb-4">
        Practical Strategies for <span class="text-gradient">Modern Digital Growth</span>
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Real-world advice from our senior software architects, performance engineers, and career consultants.
      </p>
    </header>

    <!-- Featured Post Spotlight -->
    {featuredPost && (
      <section class="mb-16">
        <div class="rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-12 group">
          <div class="lg:col-span-7 bg-slate-950 aspect-video lg:aspect-auto overflow-hidden">
            <img
              src={featuredPost.featuredImage}
              alt={featuredPost.title}
              width="800"
              height="450"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="eager"
            />
          </div>

          <div class="lg:col-span-5 p-8 sm:p-10 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 mb-3">
                <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 border border-sky-200 dark:border-sky-800">
                  Featured
                </span>
                <span class="text-xs text-slate-400">•</span>
                <span class="text-xs text-slate-500">{featuredPost.readingTime} min read</span>
              </div>

              <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors mb-4">
                <a href={`/blog/${featuredPost.slug}/`}>
                  {featuredPost.title}
                </a>
              </h2>

              <p class="text-sm text-slate-600 dark:text-slate-300 line-clamp-4 leading-relaxed mb-6">
                {featuredPost.description}
              </p>
            </div>

            <div class="pt-6 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-500">By {featuredPost.author}</span>
              <a
                href={`/blog/${featuredPost.slug}/`}
                class="text-xs font-bold text-sky-600 dark:text-sky-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
              >
                Read Full Guide →
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Remaining Articles Grid -->
    <section class="py-8">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">All Articles & Guides</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {remainingPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </section>

  </div>

  <CTA
    headline="Turn Knowledge Into Business Results"
    description="Discuss how to apply these technical strategies to your own brand via WhatsApp."
  />
</BaseLayout>

